# tkt update --check reports the release that would replace tkt and changes
# nothing. tkt under test is a development build, so the next step needs
# --force.
mkrelease v9.9.9
env TKT_RELEASES=file://$WORK/rel
env TKT_RELEASES_API=file://$WORK/api
env TKT_UPDATE_TARGET=$WORK/bin/tkt
exec tkt update --check
stdout '^v9.9.9 is available \(this tkt is test\); run tkt update --force$'
cmp $WORK/bin/tkt $WORK/old
! logged new-tkt

exec tkt update --check --json
envelope '.result | [.available, .dev, .updated, .next]' '[true,true,false,"tkt update --force"]'

-- api/releases/latest --
{"tag_name":"v9.9.9"}
-- bin/tkt --
the old tkt
-- old --
the old tkt
