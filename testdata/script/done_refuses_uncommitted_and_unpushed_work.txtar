# Uncommitted and unmerged work keeps the worktree.
mkprompt $WORK/p.txt ACM-12
stdin $WORK/p.txt
exec tkt start ACM-12 --prompt -
env WT=$FAKE_WT_ROOT/ACM-12
realgit -C $WT commit -q --allow-empty -m 'work on ACM-12'
realgit -C $WT push -q origin ACM-12
realgit -C $REPO merge -q --no-ff -m 'Merge ACM-12' ACM-12
realgit -C $REPO push -q origin main
gitvar H1 $WT HEAD
jqedit $WORK/prs.json '.[0].headRefOid = $H1'
env FAKE_GH_PRS=$WORK/prs.json
resetlog
cp $WORK/draft.txt $WT/notes.txt
realgit -C $WT commit -q --allow-empty -m 'more work'
cp $WORK/draft.txt $WT/scratch.txt
! exec tkt done ACM-12
rc 4
stderr 'uncommitted changes'
stderr 'neither the merged head nor in origin/main'
! logcontains 'herdr tab close'

# The reasons are in the error itself, for a program that reads --json and
# never sees the lines above.
! exec tkt done ACM-12 --json
envelope '.error.code' tickets_kept
envelope '.error.message | test("^kept ACM-12: .*uncommitted changes")' true

-- draft.txt --
draft

-- prs.json --
[{"number": 7, "state": "MERGED", "headRefName": "ACM-12", "headRefOid": "", "headRepository": {"nameWithOwner": "acme/app"}}]
