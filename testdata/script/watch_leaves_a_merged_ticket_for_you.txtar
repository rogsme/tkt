# tkt watch never runs tkt done after a merge: not on a merge made in the
# forge's page, not after finish-ticket's Status: DONE, and not with
# done_after_merge on. The ticket waits for you, and your tkt done names the
# tickets the merge unblocked.
exec tkt start ACM-12
env WT=$FAKE_WT_ROOT/ACM-12
realgit -C $WT commit -q --allow-empty -m 'work on ACM-12'
realgit -C $WT push -q origin ACM-12
realgit -C $REPO merge -q --no-ff -m 'Merge ACM-12' ACM-12
realgit -C $REPO push -q origin main
env FAKE_GH_PRS=$WORK/prs.json

exec tkt watch --once --json
envelope '.result.tickets' '[{"action":"","reason":"merged","ticket":"ACM-12"}]'
exists $WT

cp $WORK/screen.txt $FAKE_DIR/screen
mkdir $HOME/.config/tkt
cp $WORK/on.toml $HOME/.config/tkt/config.toml
resetlog
exec tkt watch --once --json
envelope '.result.tickets' '[{"action":"","reason":"merged","ticket":"ACM-12"}]'
exec tkt ls --json
envelope '.result.rows[0].next | [.reason, .text]' '["merged","tkt done ACM-12"]'
exists $WT

exec tkt done ACM-12
stdout 'the merge unblocked ACM-15'
logged wt -C $REPO remove ACM-12 --foreground --reap --format json
! exists $WT
houserules

-- prs.json --
[{"number": 7, "state": "MERGED", "headRefName": "ACM-12", "headRefOid": "", "headRepository": {"nameWithOwner": "acme/app"}}]
-- screen.txt --
Merged and verified.
Unblocked: ACM-15
Status: DONE
-- on.toml --
[watch]
done_after_merge = true
