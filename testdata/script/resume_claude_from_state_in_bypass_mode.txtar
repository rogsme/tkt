# tkt resume relaunches the recorded session in bypass mode and sends nothing.
mkprompt $WORK/p.txt ACM-12
stdin $WORK/p.txt
exec tkt start ACM-12 --prompt -
env WT=$FAKE_WT_ROOT/ACM-12
jqedit $FAKE_DIR/herdr.json '.agents = []'
resetlog
statevar $WT session SID
exec tkt resume ACM-12
logged herdr agent start acm-12 --kind claude --pane w1:p10 --timeout 90000 -- --resume $SID --dangerously-skip-permissions
state $WT status resumed
! exists $FAKE_DIR/prompts
