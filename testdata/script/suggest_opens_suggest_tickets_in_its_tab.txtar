# tkt suggest has suggest-tickets pick the next tickets to start, in a
# suggest tab at the repository's root, on the [suggest] preset. It reads
# nothing the agent says: the picks stay in the tab for you.
mkdir $HOME/.config/tkt
cp $WORK/config.toml $HOME/.config/tkt/config.toml

exec tkt suggest 2 --dry-run --json
envelope '.result | [.count, .preset, .dry_run]' '[2,"cheap",true]'
envelope '.result.actions[0].argv | join(" ")' 'herdr tab create --workspace w1 --cwd '$REPO' --label suggest (cheap) --no-focus'
! exists $FAKE_DIR/prompts

exec tkt suggest 2 --json
envelope '.result | [.count, .preset, .harness]' '[2,"cheap","claude"]'
grep '^Use the suggest-tickets skill to suggest the next 2 tickets to start, ones that can run side by side.$' $FAKE_DIR/prompts
logged herdr agent start suggest-app --kind claude
jqeq $FAKE_DIR/herdr.json '[.tabs[] | select(.label == "suggest (cheap)") | .label]' '["suggest (cheap)"]'

# The next run reuses the tab once its agent is idle, and returns as soon
# as the agent has the line, without waiting for the picks.
resetlog
exec tkt suggest
stdout '^suggest-tickets picks 3 in pane w1:p[0-9]+ \(cheap, claude\); read its picks there$'
! logged herdr tab create
! logged herdr agent wait
grep '^Use the suggest-tickets skill to suggest the next 3 tickets to start, ones that can run side by side.$' $FAKE_DIR/prompts

# Words other than a count are a request for suggest-tickets, such as
# tickets with a tag.
resetlog
exec tkt suggest five tickets tagged feedback --json
envelope '.result | [.count, .prompt]' '[0,"Use the suggest-tickets skill for this request: five tickets tagged feedback"]'
grep '^Use the suggest-tickets skill for this request: five tickets tagged feedback$' $FAKE_DIR/prompts
exec tkt suggest 'tickets for the fast preset'
stdout '^suggest-tickets has your request in pane w1:p[0-9]+ \(cheap, claude\); read its picks there$'

# herdr numbers panes again when its server restarts, so a kept pane id
# that now names another pane, here tkt's own, never gets the agent.
jqedit $FAKE_DIR/herdr.json '.agents |= map(select(.name != "suggest-app"))'
cp $WORK/stale.state $REPO/.git/tkt/suggest
resetlog
exec tkt suggest --json
logged herdr tab create --workspace w1 --cwd $REPO --label 'suggest (cheap)' --no-focus
envelope '.result.pane != "w1:p1"' true

# A run still at work keeps its tab.
jqedit $FAKE_DIR/herdr.json '(.agents[] | select(.name == "suggest-app") | .agent_status) = "working"'
! exec tkt suggest --json
rc 4
envelope '.error.code' agent_busy

# --as picks another preset, and the count stays within reason.
! exec tkt suggest 11 --json
rc 2
envelope '.error.code' usage
! exec tkt suggest 0 --json
rc 2
! exec tkt suggest --as nope --json
envelope '.error.code' unknown_preset
houserules

-- config.toml --
[presets.claude]
harness = "claude"
serves = ["frontier"]

[presets.cheap]
harness = "claude"
model = "haiku"
serves = ["acme-small-2"]

[suggest]
as = "cheap"
-- stale.state --
pane=w1:p1
tab=w1:t1
