# When herdr keeps calling the pane busy, tkt types the launch command into
# its shell and names the agent.
env FAKE_HERDR_START_ERRORS=agent_pane_busy,agent_pane_busy,agent_pane_busy,agent_pane_busy,agent_pane_busy,agent_pane_busy,agent_pane_busy,agent_pane_busy,agent_pane_busy,agent_pane_busy,agent_pane_busy,agent_pane_busy,agent_pane_busy,agent_pane_busy,agent_pane_busy,agent_pane_busy
mkprompt $WORK/p.txt ACM-12
stdin $WORK/p.txt
exec tkt start ACM-12 --prompt -
stderr 'typing the command'
logcontains 'herdr pane run w1:p10 \''claude\''\ \''--dangerously-skip-permissions\'''
logged herdr agent rename w1:p10 acm-12
jqeq $FAKE_DIR/herdr.json '.agents[0].name' acm-12
