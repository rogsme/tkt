# A dry run prints the commands and changes nothing.
mkprompt $WORK/p.txt ACM-12
stdin $WORK/p.txt
exec tkt start ACM-12 --dry-run --prompt -
stderr 'dry run: git -C '$REPO' fetch --quiet origin main'
stderr 'dry run: wt -C '$REPO' switch --create ACM-12 --base origin/main'
stderr 'dry run: herdr agent prompt \\<pane\\> '
! exists $FAKE_WT_ROOT/ACM-12
! logcontains 'herdr tab create'
! logcontains 'herdr agent start'
