# When the review bot says the base moved, tkt auto merges the base itself if
# the merge is clean, with no agent and no fix round, and runs the resolve
# stage when it conflicts.
cp $WORK/app-start.txt $REPO/app.txt
realgit -C $REPO add app.txt
realgit -C $REPO commit -q -m 'add app.txt'
realgit -C $REPO push -q origin main
exec tkt start ACM-12
env WT=$FAKE_WT_ROOT/ACM-12
cp $WORK/ticket.txt $WT/ticket.txt
realgit -C $WT add ticket.txt
realgit -C $WT commit -q -m 'ACM-12 work'
realgit -C $WT push -q origin ACM-12
gitvar H1 $WT HEAD
cp $WORK/other.txt $REPO/other.txt
realgit -C $REPO add other.txt
realgit -C $REPO commit -q -m 'another ticket merged'
realgit -C $REPO push -q origin main
jqedit $WORK/prs.json 'walk(if type == "string" then gsub("H1SHORT"; $H1[0:7]) | gsub("H1"; $H1) else . end)'
env FAKE_GH_PRS=$WORK/prs.json

exec tkt ls --no-fetch
stdout '^ACM-12 .*tkt sync ACM-12$'
exec tkt auto ACM-12 --once --dry-run --json
envelope '.result.did | [.action, .reason]' '["sync","base_moved"]'
resetlog
exec tkt auto ACM-12 --once --poll 100ms --json
envelope '.result | [.did.action, .rounds]' '["sync",0]'
! logcontains 'herdr agent start'
gitvar NEW $WT HEAD
realgit -C $WORK/origin.git rev-parse ACM-12
stdout ^$NEW
state $WT rounds 0

# A base that conflicts goes to the resolve stage, which counts a round.
cp $WORK/app-ticket.txt $WT/app.txt
realgit -C $WT commit -q -am 'ACM-12 changes app.txt'
realgit -C $WT push -q origin ACM-12
gitvar H1 $WT HEAD
cp $WORK/app-main.txt $REPO/app.txt
realgit -C $REPO commit -q -am 'another ticket changes app.txt'
realgit -C $REPO push -q origin main
cp $WORK/prs.orig.json $WORK/prs.json
jqedit $WORK/prs.json 'walk(if type == "string" then gsub("H1"; $H1) else . end)'
# The forge still says mergeable and the review is clear, but git
# merge-tree, which tkt auto runs, finds the conflict.
exec tkt ls --no-fetch --json
envelope '.result.rows[0] | [.next.reason, .base_merge]' '["review_clear",""]'
exec tkt auto ACM-12 --once --poll 100ms --json
envelope '.result | [.did.action, .did.stage, .did.reason, .rounds]' '["run","resolve","base_moved",1]'
grep 'The merge conflicts: resolve it with the resolving-merge-conflicts skill' $FAKE_DIR/prompts
houserules

-- app-start.txt --
one
-- app-ticket.txt --
one, as ACM-12 wants it
-- app-main.txt --
one, as another ticket wants it
-- ticket.txt --
ACM-12's change.
-- other.txt --
Another ticket's change.
-- prs.json --
[{"number": 4, "state": "OPEN", "headRefName": "ACM-12", "headRefOid": "H1", "headRepository": {"nameWithOwner": "acme/app"}, "mergeable": "MERGEABLE",
  "statusCheckRollup": [{"name": "tests", "status": "COMPLETED", "conclusion": "SUCCESS"}],
  "reviews": [{"author": {"login": "claude"}, "body": "**Automated review: STALE_BASE** · head `H1SHORT`", "submittedAt": "2026-01-02T00:00:00Z", "commit": {"oid": "H1"}}]}]
-- prs.orig.json --
[{"number": 4, "state": "OPEN", "headRefName": "ACM-12", "headRefOid": "H1", "headRepository": {"nameWithOwner": "acme/app"}, "mergeable": "MERGEABLE",
  "statusCheckRollup": [{"name": "tests", "status": "COMPLETED", "conclusion": "SUCCESS"}],
  "reviews": [{"author": {"login": "dev"}, "body": "Reviewed head: H1\nVerdict: READY_FOR_HUMAN\n\n## Human verification\n\n1. Open the app.\n", "submittedAt": "2026-01-02T00:00:00Z", "commit": {"oid": "H1"}}]}]
