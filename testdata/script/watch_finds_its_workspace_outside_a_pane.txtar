# Outside a herdr pane, as under a service, tkt watch finds the workspace
# whose panes work in the repository, and opens its tabs there.
exec tkt start ACM-1
realgit -C $FAKE_WT_ROOT/ACM-1 commit -q --allow-empty -m 'ACM-1 work'
realgit -C $FAKE_WT_ROOT/ACM-1 push -q origin ACM-1
gitvar H1 $FAKE_WT_ROOT/ACM-1 HEAD
jqedit $WORK/prs.json '.[0].headRefOid = $H1'
env FAKE_GH_PRS=$WORK/prs.json
env HERDR_ENV=
env HERDR_WORKSPACE_ID=
env HERDR_TAB_ID=
env HERDR_PANE_ID=

# The ticket's tab is gone, so the ci run opens a new one in the workspace.
jqedit $FAKE_DIR/herdr.json '.agents = [] | .tabs |= map(select(.tab_id == "w1:t1")) | .panes |= map(select(.pane_id == "w1:p1"))'
exec tkt watch --once --json
envelope '.result.tickets[0] | [.action, .stage]' '["run","ci"]'
logged herdr tab create --workspace w1 --cwd $FAKE_WT_ROOT/ACM-1 --label 'ACM-1 (claude)'
logged herdr agent start acm-1 --kind claude

# With no pane in the repository, as after a reboot with nothing open, it
# opens a workspace there for its step. A dry run says it would.
jqedit $FAKE_DIR/herdr.json '.panes = [] | .agents = [] | .tabs = []'
realgit -C $FAKE_WT_ROOT/ACM-1 commit -q --allow-empty -m 'ACM-1 more work'
realgit -C $FAKE_WT_ROOT/ACM-1 push -q origin ACM-1
gitvar H2 $FAKE_WT_ROOT/ACM-1 HEAD
jqedit $WORK/prs.json '.[0].headRefOid = $H2'
exec tkt watch --once --dry-run --json
envelope '.result.actions[0].display' 'herdr workspace create --cwd '$REPO' --label app --no-focus'
! logged herdr workspace create
exec tkt watch --once --json
envelope '.result.tickets[0] | [.action, .stage]' '["run","ci"]'
stderr 'no herdr workspace had a pane in '$REPO', so tkt watch opened workspace w[0-9]+ there'
logged herdr workspace create --cwd $REPO --label app --no-focus
jqeq $FAKE_DIR/herdr.json '[.tabs[] | select(.label == "ACM-1 (claude)") | .workspace_id] | length' 1
jqeq $FAKE_DIR/herdr.json '[.tabs[] | select(.label == "ACM-1 (claude)") | .workspace_id][0] == ([.workspaces[] | select(.label == "app") | .workspace_id][0])' true

# The next pass finds that workspace from its pane, and opens no other.
resetlog
exec tkt watch --once --json
! logged herdr workspace create

-- prs.json --
[{"number": 1, "state": "OPEN", "headRefName": "ACM-1", "headRefOid": "", "headRepository": {"nameWithOwner": "acme/app"}, "mergeable": "MERGEABLE",
  "statusCheckRollup": [{"name": "tests", "status": "COMPLETED", "conclusion": "FAILURE"}], "reviews": []}]
