# Once finish-ticket ends with Status: DONE after the merge, tkt watch runs
# tkt done. A merge without that status, such as one made in the forge's
# page, waits for you, and so does every merge with done_after_merge off.
exec tkt start ACM-12
env WT=$FAKE_WT_ROOT/ACM-12
realgit -C $WT commit -q --allow-empty -m 'work on ACM-12'
realgit -C $WT push -q origin ACM-12
realgit -C $REPO merge -q --no-ff -m 'Merge ACM-12' ACM-12
realgit -C $REPO push -q origin main
env FAKE_GH_PRS=$WORK/prs.json

exec tkt watch --once --json
envelope '.result.tickets' '[{"action":"","reason":"merged","ticket":"ACM-12"}]'
exists $WT

env 'FAKE_HERDR_SCREEN=Merged and verified. Status: DONE'
mkdir $HOME/.config/tkt
cp $WORK/off.toml $HOME/.config/tkt/config.toml
exec tkt watch --once --json
envelope '.result.tickets[0].reason' merged
exists $WT

rm $HOME/.config/tkt/config.toml
resetlog
exec tkt watch --once --json
envelope '.result.tickets' '[{"action":"done","reason":"merged","ticket":"ACM-12"}]'
logged wt -C $REPO remove ACM-12 --foreground --reap --format json
logged herdr notification show 'ACM-12: removed'
! exists $WT
houserules

-- prs.json --
[{"number": 7, "state": "MERGED", "headRefName": "ACM-12", "headRefOid": "", "headRepository": {"nameWithOwner": "acme/app"}}]
-- off.toml --
[watch]
done_after_merge = false
