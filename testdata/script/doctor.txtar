# tkt doctor checks the tools, the environment and both configurations.
exec tkt doctor
stdout '^ok    git '
stdout '^ok    lifecycle        tickets match \^ACM-\[1-9\]\[0-9\]\*\$; forge GitHub acme/app, base origin/main$'
stdout '^ok    herdr            herdr 0.9.3$'
stdout '^ok    wt               wt v0.68.0$'
stdout '^ok    gh '
stdout '^ok    harness.claude   2.1.303'
stdout '^ok    harness.opencode '
stdout '^ok    config           presets claude, opencode from built-in presets$'

# An old herdr fails the run with exit 3.
env FAKE_HERDR_VERSION=0.9.2
! exec tkt doctor --json
rc 3
envelope '.error.code' checks_failed
envelope '[.error.details.checks[] | select(.status == "fail") | .id]' '["herdr"]'
envelope '.error.details.checks[] | select(.id == "herdr") | .hint' 'update herdr to 0.9.3 or newer'
env FAKE_HERDR_VERSION=

# Outside herdr and outside a repository, checks warn or skip.
env HERDR_ENV=
cd $WORK
! exec tkt doctor --json
envelope '[.error.details.checks[] | select(.id == "repository" or .id == "lifecycle" or .id == "herdr_env") | .status]' '["fail","skip","warn"]'
cd $REPO

# A config.toml next to the old files works, with a warning to delete them.
mkdir $HOME/.config/tkt
cp $WORK/config.toml $HOME/.config/tkt/config.toml
cp $WORK/config.toml $HOME/.config/tkt/presets
exec tkt doctor
stdout '^warn  config           presets fast from .*ignoring .*presets$'
! stdout 'harness.claude'

# The repository's .tkt files add its settings and chores. Your own file
# warns until git ignores it, since git add -A would commit it.
rm $HOME/.config/tkt/presets
mkdir $REPO/.tkt
cp $WORK/tkt.toml $REPO/.tkt/tkt.toml
cp $WORK/tkt.local.toml $REPO/.tkt/tkt.local.toml
exec tkt doctor
stdout '^warn  config           presets fast from .*config\.toml; repository settings from .*/\.tkt/tkt\.toml and .*/\.tkt/tkt\.local\.toml; git does not ignore '
stdout 'hint: list tkt\.local\.toml in .*/\.tkt/\.gitignore'
stdout '^warn  chores           no tkt watch runs for this repository, so its chores never start: deps \(next '
cp $WORK/gitignore $REPO/.tkt/.gitignore
exec tkt doctor
stdout '^ok    config           presets fast from .*config\.toml; repository settings from .*/\.tkt/tkt\.toml and .*/\.tkt/tkt\.local\.toml$'

# Git tracking your own file fails the check, and every repository command.
realgit -C $REPO add -f .tkt/tkt.local.toml
! exec tkt doctor
stdout '^fail  config           git tracks .*/\.tkt/tkt\.local\.toml, which holds your own settings and chores'
stdout 'hint: run git rm --cached \.tkt/tkt\.local\.toml and commit'
! exec tkt ls --json
rc 3
envelope '.error.code' config_local_tracked
realgit -C $REPO rm -q --cached .tkt/tkt.local.toml

# A file that does not parse fails the config check.
cp $WORK/presets.toml $REPO/.tkt/tkt.toml
! exec tkt doctor
stdout '^fail  config           .*\.tkt/tkt\.toml: \[presets\] belongs in '

-- config.toml --
[presets.fast]
harness = "opencode"
model = "acme/fast#max"
-- tkt.toml --
[review]
bot_wait = "0s"
-- tkt.local.toml --
[chores.deps]
schedule = "0 9 * * 1"
prompt = "Upgrade the dependencies."
-- gitignore --
tkt.local.toml
-- presets.toml --
[presets.big]
harness = "claude"
