# A .tkt.toml takes no [presets] and no [agent]: they choose the harnesses,
# models and pi extensions that run on your machine, and a file anyone can
# commit to the repository must not.
cp $WORK/presets.toml $REPO/.tkt.toml
! exec tkt start ACM-1 --dry-run
rc 3
stderr '\.tkt\.toml: \[presets\] belongs in .*/tkt/config\.toml'
cp $WORK/agent.toml $REPO/.tkt.toml
! exec tkt ls --json
rc 3
envelope '.error.code' config_invalid
envelope '.error.message | test("\\[agent\\] belongs in")' 'true'

-- presets.toml --
[presets.fast]
harness = "opencode"
-- agent.toml --
[agent]
extensions = ["~/acme.ts"]
