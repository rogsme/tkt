# tkt watch --install runs the repository's tkt watch, and herdr's server,
# as systemd user units. Both carry this shell's PATH, since agents in
# herdr's panes inherit herdr's. A dry run says what it would change.
env TKT_SERVICE_MANAGER=systemd
env UNITS=$HOME/.config/systemd/user
unitvar REPO_ESC $REPO
exec tkt watch --install --dry-run
stderr 'dry run: tee '$UNITS'/herdr.service'
stderr 'dry run: tee '$UNITS'/tkt-watch@.service'
stderr 'dry run: systemctl --user daemon-reload'
stderr 'dry run: systemctl --user restart tkt-watch@\S+-app\.service'
! exists $UNITS/herdr.service
! logged systemctl --user enable

# Without linger, systemd stops a user's units when the last session ends,
# and herdr's would take every agent with it, so herdr's unit stays off.
# Without a terminal, the answer to the linger question is no.
exec tkt watch --install --json
envelope '.result.service | [.manager, .herdr, .linger, .removed]' '["systemd","off","no",false]'
envelope '.result.service.unit' 'tkt-watch@'$REPO_ESC'.service'
grep '^Environment="PATH=' $UNITS/herdr.service
grep '^ExecStart=.*/herdr server$' $UNITS/herdr.service
grep '^ExecStart=.*/tkt watch$' $UNITS/tkt-watch@.service
grep '^WorkingDirectory=%f$' $UNITS/tkt-watch@.service
grep '^KillMode=mixed$' $UNITS/tkt-watch@.service
stderr 'linger is off, and systemd stops a user''s units when the last session ends'
logged systemctl --user daemon-reload
! logged systemctl --user enable herdr.service
jqeq $FAKE_DIR/systemd.json '[.enabled[] | sub("@.*"; "@")]' '["tkt-watch@"]'
jqeq $FAKE_DIR/systemd.json '[.active[] | sub("@.*"; "@")]' '["tkt-watch@"]'

# tkt doctor sees the unit run, with a PATH that finds the tools.
exec tkt doctor --json
envelope '.result.checks[] | select(.id == "services") | .status' ok
envelope '.result.checks[] | select(.id == "services") | .message' 'tkt-watch@'$REPO_ESC'.service runs tkt watch from login to logout, and herdr runs as you start it, since linger is off'

# --stop stops the unit, which would start the watch again otherwise.
exec tkt watch --stop
stdout 'stopped tkt watch for '$REPO
logged systemctl --user stop tkt-watch@$REPO_ESC.service
exec tkt doctor --json
envelope '.result.checks[] | select(.id == "services") | .status' warn
envelope '.result.checks[] | select(.id == "services") | .hint' 'systemctl --user start tkt-watch@'$REPO_ESC'.service'

# The next tkt command in a herdr pane starts the unit, not a watch of its
# own.
env TKT_WATCH=
exec tkt ls --no-fetch
stderr 'started tkt-watch@\S+-app\.service, which keeps'
logged systemctl --user start --no-block tkt-watch@$REPO_ESC.service
! exists $REPO/.git/tkt/watch
env TKT_WATCH=off

# --yes turns linger on, and herdr's unit with it. herdr's server already
# runs here, so its unit waits for the next start: a second server would
# only fail.
exec tkt watch --install --yes --json
envelope '.result.service | [.herdr, .linger]' '["running","yes"]'
logged loginctl enable-linger
logged systemctl --user enable herdr.service
! logged systemctl --user start herdr.service
stderr 'herdr''s server already runs outside herdr.service'

# A watch that a tkt command started stops for the unit's, and with herdr
# down this time, tkt starts herdr's unit.
rm $REPO/.git/tkt/watch.started
exec tkt watch &
waitfile $REPO/.git/tkt/watch
jqedit $FAKE_DIR/systemd.json '.active = []'
env FAKE_HERDR_DOWN=1
exec tkt watch --install --dry-run
stderr 'dry run: kill -TERM [0-9]+'
exec tkt watch --install --json
envelope '.result.service | [.herdr, .linger]' '["started","yes"]'
wait
logged systemctl --user start herdr.service
env FAKE_HERDR_DOWN=
exec tkt ls --no-fetch --json
envelope '.result.watch.running' false
exec tkt doctor --json
envelope '.result.checks[] | select(.id == "services") | .message' 'tkt-watch@'$REPO_ESC'.service runs tkt watch'

# herdr's unit with linger off would stop with the last session.
exec sh -c 'echo no > "$FAKE_DIR/linger"'
exec tkt doctor --json
envelope '.result.checks[] | select(.id == "services") | [.status, .hint]' '["warn","loginctl enable-linger"]'

# --uninstall stops and disables the repository's unit; herdr's stays.
exec tkt watch --uninstall
stdout 'removed tkt-watch@\S+-app\.service'
logged systemctl --user disable --now tkt-watch@$REPO_ESC.service
jqeq $FAKE_DIR/systemd.json '.enabled' '["herdr.service"]'
jqeq $FAKE_DIR/systemd.json '.active' '["herdr.service"]'
exists $UNITS/tkt-watch@.service
exec tkt watch --uninstall
stderr 'does not run as a service'

# A system with neither systemd nor launchd has nothing to install into.
env TKT_SERVICE_MANAGER=none
! exec tkt watch --install --json
rc 3
envelope '.error.code' service_unsupported
