# A step you skip counts as waived once you say why: tkt verified names it
# on the pull request, tkt ls reads it back, and the merge line tells
# finish-ticket, which takes a step waived with a reason in place of a pass.
exec tkt start ACM-12
realgit -C $FAKE_WT_ROOT/ACM-12 commit -q --allow-empty -m 'work on ACM-12'
realgit -C $FAKE_WT_ROOT/ACM-12 push -q origin ACM-12
gitvar H1 $FAKE_WT_ROOT/ACM-12 HEAD
jqedit $WORK/prs.json 'walk(if type == "string" then gsub("H1"; $H1) else . end)'
env FAKE_GH_PRS=$WORK/prs.json
jqedit $FAKE_DIR/herdr.json '.agents[0].agent_status = "idle"'

# A waiver needs a reason, a step of the procedure, and a step that passed.
! exec tkt verified ACM-12 --passed 1,2 --waived 3
rc 2
stderr '--waived and --reason go together'
! exec tkt verified ACM-12 --passed 1,2 --reason 'no step named'
rc 2
! exec tkt verified ACM-12 --passed 1 --waived 3 --reason '   '
rc 2
stderr '--waived needs --reason'
! exec tkt verified ACM-12 --passed 1,2 --waived 9 --reason 'no such step'
stderr '--waived names step 9, but the pull request''s procedure has steps 1 to 3'
! exec tkt verified ACM-12 --passed all --waived 1-3 --reason 'nothing ran'
stderr 'at least one step must pass'
! exec tkt verified ACM-12 --passed 1 --waived 3 --reason 'step 2 is left out'
stderr 'names step 1, but the pull request''s procedure has steps 1 to 3, with step 3 waived'
! exec tkt verified ACM-12 --passed 1,2,3 --waived 3 --reason 'both'
stderr 'names steps 1 to 3'
! exists $FAKE_DIR/comments.txt

exec tkt verified ACM-12 --passed all --waived 3 --reason 'it needs   production credentials' --head $H1 --json
envelope '.result | [.action, .steps, .waived]' '["commented",[1,2],[3]]'
grep '^Human verification passed ' $FAKE_DIR/comments.txt
grep '^Steps 1 and 2 passed on head '$H1'\.$' $FAKE_DIR/comments.txt
grep '^Skipped steps: 3$' $FAKE_DIR/comments.txt
grep '^Reason: it needs production credentials$' $FAKE_DIR/comments.txt
exec tkt history ACM-12
stdout 'human verification passed, step 3 skipped; commented on #7'

# Once per head, for the same steps.
exec tkt verified ACM-12 --passed all --waived 3 --reason 'it needs production credentials' --json
envelope '.result.action' none

# tkt ls reads it back, and the merge waits for your word.
exec tkt ls --json
envelope '.result.rows[0] | [.next.reason, .phase, .confirmed.waived, .confirmed.reason]' '["steps_passed","ready_to_merge",[3],"it needs production credentials"]'
exec tkt ls
stdout 'step 3 skipped, and the others passed on [0-9a-f]{7}: tkt merge ACM-12 --passed all --head '$H1' --waived 3 --reason it\\ needs\\ production\\ credentials when you want it merged'

# An order keeps the waiver while the checks run.
jqedit $WORK/prs.json '.[0].statusCheckRollup[0] |= (.status = "IN_PROGRESS" | .conclusion = "")'
exec tkt merge ACM-12 --passed all --waived 3 --reason 'it needs production credentials' --head $H1 --json
envelope '.result | [.action, .steps, .waived]' '["ordered",[1,2],[3]]'
state $FAKE_WT_ROOT/ACM-12 merge_steps 1,2
state $FAKE_WT_ROOT/ACM-12 merge_waived 3
state $FAKE_WT_ROOT/ACM-12 merge_reason 'it needs production credentials'
exec tkt ls --no-fetch --json
envelope '.result.rows[0].merge | [.steps, .waived, .reason]' '[[1,2],[3],"it needs production credentials"]'

# tkt watch sends the line once the checks pass, with the waiver in it.
jqedit $WORK/prs.json '.[0].statusCheckRollup[0] |= (.status = "COMPLETED" | .conclusion = "SUCCESS")'
exec tkt ls --no-fetch --json
envelope '.result.rows[0] | [.next.reason, .next.argv]' '["merge_due",["tkt","merge","ACM-12","--passed","1,2","--head","'$H1'","--waived","3","--reason","it needs production credentials"]]'
exec tkt watch --once --json
envelope '.result.tickets[0] | [.action, .reason]' '["merge","merge_due"]'
grep '^Use the finish-ticket skill to merge the PR. Human verification steps 1 and 2 passed on head '$H1'. The user waived step 3: it needs production credentials.$' $FAKE_DIR/prompts

# With every step passing later, a second comment says so.
exec tkt merge ACM-12 --cancel
exec tkt verified ACM-12 --passed all --head $H1 --json
envelope '.result | [.action, .waived]' '["commented",[]]'
exec tkt ls --json
envelope '.result.rows[0].confirmed.waived' '[]'
state $FAKE_WT_ROOT/ACM-12 merge_waived ''
state $FAKE_WT_ROOT/ACM-12 merge_reason ''
houserules

-- prs.json --
[{"number": 7, "state": "OPEN", "headRefName": "ACM-12", "headRefOid": "H1", "headRepository": {"nameWithOwner": "acme/app"},
  "mergeable": "MERGEABLE", "statusCheckRollup": [{"name": "tests", "status": "COMPLETED", "conclusion": "SUCCESS"}],
  "reviews": [{"body": "Reviewed head: H1\nReviewed base: cccc\nVerdict: READY_FOR_HUMAN\n\n## Human verification\n\n1. Open the login page.\n   Expected: it shows.\n2. Sign in with the code sent by text.\n   Expected: the dashboard.\n3. Pay with a real card.\n   Expected: the receipt.\n", "submittedAt": "2026-01-02T00:00:00Z", "commit": {"oid": "H1"}}]}]
