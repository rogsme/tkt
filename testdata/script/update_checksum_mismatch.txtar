# A binary that does not match SHA256SUMS never runs and replaces nothing, and
# the download is removed.
mkrelease v9.9.9
cp $WORK/tampered $WORK/rel/v9.9.9/tkt_linux_amd64
cp $WORK/tampered $WORK/rel/v9.9.9/tkt_linux_arm64
cp $WORK/tampered $WORK/rel/v9.9.9/tkt_darwin_amd64
cp $WORK/tampered $WORK/rel/v9.9.9/tkt_darwin_arm64
env TKT_RELEASES=file://$WORK/rel
env TKT_RELEASES_API=file://$WORK/api
env TKT_UPDATE_TARGET=$WORK/bin/tkt
! exec tkt update --force --json
rc 1
envelope '.error.code' update_checksum
cmp $WORK/bin/tkt $WORK/old
! logged new-tkt
exec ls -A $WORK/bin
stdout '^tkt$'
! stdout 'update'

-- api/releases/latest --
{"tag_name":"v9.9.9"}
-- tampered --
#!/bin/sh
echo "tkt version v9.9.9"
-- bin/tkt --
the old tkt
-- old --
the old tkt
