# With no verdict at the head, tkt ls waits [review] bot_wait for the review
# bot from the moment it first sees the head waiting. The bot in CI is the
# reviewer: when it stays silent, the ticket needs you, and review-pr is the
# next step only in a repository with no bot.
mkprompt $WORK/p.txt ACM-12
stdin $WORK/p.txt
exec tkt start ACM-12 --prompt -
env FAKE_GH_PRS=$WORK/prs.json
exec tkt ls --no-fetch
stdout '^ACM-12 +waiting_review .*wait for the review bot$'
exec tkt ls --no-fetch --json
envelope '.result.rows[0].next.reason' awaiting_bot

# The wait counts from the phase file, which tkt ls wrote above; a clock
# that started long ago has run out.
cp $WORK/phase-old $REPO/.git/worktrees/ACM-12/tkt/phase
exec tkt ls --no-fetch --json
envelope '.result.rows[0].next | [.reason, .kind]' '["bot_silent","human"]'
envelope '.result.rows[0].phase' needs_you

# A new head starts the clock again.
jqedit $WORK/prs.json '.[0].headRefOid = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"'
exec tkt ls --no-fetch --json
envelope '.result.rows[0].next.reason' awaiting_bot

# Without a bot, review-pr is next at once.
mkdir $HOME/.config/tkt
cp $WORK/nobot.toml $HOME/.config/tkt/config.toml
exec tkt ls --no-fetch
stdout '^ACM-12 .*tkt run ACM-12 review$'

-- phase-old --
head=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
phase=waiting_review
since=2020-01-01T00:00:00Z
-- nobot.toml --
[review]
bot_wait = "0s"
-- prs.json --
[{"number": 4, "state": "OPEN", "headRefName": "ACM-12", "headRefOid": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "headRepository": {"nameWithOwner": "acme/app"},
  "mergeable": "MERGEABLE", "statusCheckRollup": [{"name": "tests", "status": "COMPLETED", "conclusion": "SUCCESS"}], "reviews": []}]
