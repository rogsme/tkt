# tkt resume skips plan-review and child sessions in OpenCode.
mkdir $HOME/.config/tkt
cp $WORK/config.toml $HOME/.config/tkt/config.toml
realgit -C $REPO worktree add -q -b ACM-12 $FAKE_WT_ROOT/ACM-12 main
jqedit $WORK/sessions.json '.data |= map(.location.directory = ($FAKE_WT_ROOT + "/ACM-12"))'
env FAKE_OC_SESSIONS=$WORK/sessions.json
exec tkt resume ACM-12
logged herdr agent start acm-12 --kind opencode --pane w1:p10 --timeout 90000 -- -s ses_work $FAKE_WT_ROOT/ACM-12
logcontains '--label ACM-12\ \(big\)'

-- sessions.json --
{"data": [
  {"id": "ses_review", "agent": "plan-review", "parentID": null, "location": {}, "time": {"updated": 3}},
  {"id": "ses_child", "agent": "general", "parentID": "ses_work", "location": {}, "time": {"updated": 2}},
  {"id": "ses_work", "agent": "build", "parentID": null, "location": {}, "time": {"updated": 1}}
]}
-- config.toml --
[presets.claude]
harness = "claude"
serves = ["frontier"]

[presets.big]
harness = "opencode"
model = "acme/big#high"
serves = ["frontier"]

[presets.fast]
harness = "opencode"
model = "acme/fast#max"
serves = ["small"]
