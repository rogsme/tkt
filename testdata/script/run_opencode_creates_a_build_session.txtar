# On an OpenCode preset, tkt run creates a fresh build session.
mkdir $HOME/.config/tkt
cp $WORK/config.toml $HOME/.config/tkt/config.toml
mkprompt $WORK/p.txt ACM-12
stdin $WORK/p.txt
exec tkt start ACM-12 --as fast --prompt -
env WT=$FAKE_WT_ROOT/ACM-12
realgit -C $WT commit -q --allow-empty -m 'work on ACM-12'
resetlog
exec tkt run ACM-12 sync
logged herdr agent start acm-12 --kind opencode --pane w1:p10 --timeout 90000 -- -s ses_fake2 $WT
grep 'address the review on this branch' $FAKE_DIR/prompts

-- config.toml --
[presets.claude]
harness = "claude"
serves = ["frontier"]

[presets.big]
harness = "opencode"
model = "acme/big#high"
serves = ["frontier"]

[presets.fast]
harness = "opencode"
model = "acme/fast#max"
serves = ["small"]
