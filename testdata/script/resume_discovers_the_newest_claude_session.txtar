# Without recorded state, tkt resume finds the newest Claude Code session.
realgit -C $REPO worktree add -q -b ACM-12 $FAKE_WT_ROOT/ACM-12 main
claudedir DIR $FAKE_WT_ROOT/ACM-12
touchat $DIR/11111111-1111-1111-1111-111111111111.jsonl 2026-01-01
touchat $DIR/22222222-2222-2222-2222-222222222222.jsonl 2026-01-02
exec tkt resume ACM-12
logged -- --resume 22222222-2222-2222-2222-222222222222 --dangerously-skip-permissions
logged herdr tab create --workspace w1 --cwd $FAKE_WT_ROOT/ACM-12 --label 'ACM-12 (claude)'
