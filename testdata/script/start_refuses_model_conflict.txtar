# --as must serve the prompt's Model: value.
mkdir $HOME/.config/tkt
cp $WORK/config.toml $HOME/.config/tkt/config.toml
mkprompt $WORK/p.txt ACM-6 'Model: small'
stdin $WORK/p.txt
! exec tkt start ACM-6 --as claude --prompt -
rc 2
! logcontains 'wt -C'

-- config.toml --
[presets.claude]
harness = "claude"
serves = ["frontier"]

[presets.big]
harness = "opencode"
model = "acme/big#high"
serves = ["frontier"]

[presets.fast]
harness = "opencode"
model = "acme/fast#max"
serves = ["small"]
