# tkt schema describes the commands for programs; it works anywhere.
cd $WORK
exec tkt schema --json
envelope '[.result.commands[].path]' '["start","run","resume","done","ls","wait","doctor","schema"]'
envelope '.result.commands[] | select(.path == "run") | [.args[] | "\(.name):\(.required)"]' '["ID:true","STAGE:false"]'
envelope '.result.commands[] | select(.path == "ls") | .result.rows[0].next' '{"argv":"array of string","kind":"string","text":"string"}'
envelope '[.result.errors[] | select(.code == "wait_timeout") | .exit]' '[4]'
envelope '[.result.topics[].name]' '["json","exit-codes","config"]'

# Without --json it prints the description itself.
exec tkt schema
stdout '^  "contract_version": 1,$'
