#!/usr/bin/env bash
# shellcheck disable=SC2016
# Fake gh for the tkt tests: `pr list` answers from $FAKE_GH_PRS.
set -euo pipefail
{
  printf 'gh' 
  printf ' %q' "$@"
  printf '\n'
} >>"$FAKE_LOG"
[[ ${FAKE_GH_FAIL:-} != 1 ]] || {
  echo "HTTP 502" >&2
  exit 1
}
[[ $1 == pr && $2 == list ]] || {
  echo "fake gh: unsupported: $*" >&2
  exit 2
}
head='' state=open
while (($#)); do
  case $1 in
    --head) head=$2 && shift 2 ;;
    --state) state=$2 && shift 2 ;;
    *) shift ;;
  esac
done
jq -c --arg h "$head" --arg s "$state" \
  '[.[] | select(($h == "" or .headRefName == $h) and ($s == "all" or (.state | ascii_downcase) == $s))]' "${FAKE_GH_PRS:-/dev/null}" 2>/dev/null || echo '[]'
