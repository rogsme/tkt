#!/usr/bin/env bash
# shellcheck disable=SC2016
# Fake worktrunk for the tkt tests: real git worktrees under $FAKE_WT_ROOT.
set -euo pipefail
{
  printf 'wt' 
  printf ' %q' "$@"
  printf '\n'
} >>"$FAKE_LOG"
G=$REAL_GIT
dir=$PWD
while (($#)); do
  case $1 in
    -C) dir=$2 && shift 2 ;;
    *) break ;;
  esac
done
cmd=$1
shift
list() {
  "$G" -C "$dir" worktree list --porcelain | awk '
    /^worktree / { if (p) print p "\t" b; p = substr($0, 10); b = "" }
    /^branch / { b = substr($0, 19) }
    END { if (p) print p "\t" b }' |
    jq -R -s -c 'split("\n") | map(select(. != "") | split("\t") | {path: .[0], branch: (if .[1] == "" then null else .[1] end)})'
}
case $cmd in
  list)
    if [[ ${FAKE_WT_SCHEMA:-1} == 2 ]]; then
      list | jq -c '{schema: 2, repo: {}, items: map({branch, worktree: {path, branch_mismatch: false}})}'
    else
      list | jq -c 'map({branch, path, kind: "worktree", worktree: {detached: false}})'
    fi ;;
  switch)
    create=0 branch=
    while (($#)); do
      case $1 in
        --create) create=1 && shift ;;
        --format) shift 2 ;;
        --*) shift ;;
        *) branch=$1 && shift ;;
      esac
    done
    path=$FAKE_WT_ROOT/$branch
    if [[ -d $path ]]; then
      jq -nc --arg b "$branch" --arg p "$path" '{action: "existing", branch: $b, path: $p}'
      exit 0
    fi
    if ((create)); then
      "$G" -C "$dir" worktree add -q -b "$branch" "$path" main
    else
      "$G" -C "$dir" worktree add -q "$path" "$branch"
    fi
    if [[ ${FAKE_WT_SWITCH_FAIL:-} == 1 ]]; then
      echo "pre-start command failed" >&2
      exit 1
    fi
    jq -nc --arg b "$branch" --arg p "$path" --argjson c "$create" '{action: "created", branch: $b, path: $p, created_branch: ($c == 1)}' ;;
  remove)
    branch=$1
    path=$FAKE_WT_ROOT/$branch
    "$G" -C "$dir" worktree remove "$path"
    "$G" -C "$dir" branch -d "$branch" >/dev/null 2>&1 || true
    echo '{}' ;;
  hook) printf '%s\n' "${FAKE_WT_HOOKS:-}" ;;
  *)
    echo "fake wt: unsupported: $cmd" >&2
    exit 2 ;;
esac
