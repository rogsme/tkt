#!/usr/bin/env bash
# shellcheck disable=SC2016
# Fake herdr for the tkt tests. State lives in $FAKE_DIR/herdr.json.
set -euo pipefail
{
  printf 'herdr' 
  printf ' %q' "$@"
  printf '\n'
} >>"$FAKE_LOG"
S=$FAKE_DIR/herdr.json

state() { jq -c "$@" "$S"; }
save() {
  local tmp
  tmp=$(mktemp)
  jq "$@" "$S" >"$tmp"
  mv "$tmp" "$S"
}
fail() {
  jq -nc --arg c "$1" '{error: {code: $c, message: $c}, id: "fake"}' >&2
  exit 1
}
ok() { jq -nc --argjson r "$1" '{id: "fake", result: $r}'; }
# Finds an agent by name or pane id.
agent_of() { state --arg t "$1" '[.agents[] | select(.name == $t or .pane_id == $t)][0] // empty'; }
next_id() {
  local n
  n=$(state '.next')
  save '.next += 1'
  printf '%s' "$n"
}
# Takes the next injected error for an operation, if any.
injected() {
  local var=$1 f=$FAKE_DIR/$1.count list n
  list=${!var:-}
  [[ $list ]] || return 1
  n=$(cat "$f" 2>/dev/null || echo 0)
  echo $((n + 1)) >"$f"
  IFS=, read -ra errs <<<"$list"
  ((n < ${#errs[@]})) || return 1
  [[ ${errs[n]} != - ]] || return 1
  printf '%s' "${errs[n]}"
}

group=$1 cmd=$2
shift 2
case "$group $cmd" in
  "workspace list") ok "$(state '{type: "workspace_list", workspaces: .workspaces}')" ;;
  "tab list")
    ok "$(state --arg w "$2" '{tabs: [.tabs[] | select(.workspace_id == $w)]}')" ;;
  "tab create")
    ws='' cwd='' label=''
    while (($#)); do
      case $1 in
        --workspace) ws=$2 && shift 2 ;;
        --cwd) cwd=$2 && shift 2 ;;
        --label) label=$2 && shift 2 ;;
        *) shift ;;
      esac
    done
    n=$(next_id)
    save --arg w "$ws" --arg c "$cwd" --arg l "$label" --arg n "$n" \
      '.tabs += [{tab_id: ($w + ":t" + $n), workspace_id: $w, label: $l}]
       | .panes += [{pane_id: ($w + ":p" + $n), tab_id: ($w + ":t" + $n), workspace_id: $w, cwd: $c, foreground_cwd: $c}]'
    ok "$(jq -nc --arg w "$ws" --arg n "$n" '{tab: {tab_id: ($w + ":t" + $n)}, root_pane: {pane_id: ($w + ":p" + $n)}}')" ;;
  "tab close")
    save --arg t "$1" '.agents |= map(select(.tab_id != $t)) | .panes |= map(select(.tab_id != $t)) | .tabs |= map(select(.tab_id != $t))'
    ok '{"type": "ok"}' ;;
  "tab focus") ok '{"type": "ok"}' ;;
  "pane list")
    ok "$(state '{panes: [.agents as $a | .panes[] | . as $p
      | ($a | map(select(.pane_id == $p.pane_id))[0]) as $ag
      | $p + (if $ag then {agent: $ag.agent, agent_status: $ag.agent_status} else {agent_status: "unknown"} end)]}')" ;;
  "pane get")
    p=$(state --arg p "$1" '[.panes[] | select(.pane_id == $p)][0] // empty')
    [[ $p ]] || fail pane_not_found
    ok "$(jq -c '{pane: .}' <<<"$p")" ;;
  "pane process-info")
    [[ $1 == --pane ]] && shift
    [[ $(state --arg p "$1" '[.panes[] | select(.pane_id == $p)] | length') == 1 ]] || fail pane_not_found
    if [[ $(agent_of "$1") ]]; then fg=2; else fg=1; fi
    ok "$(jq -nc --argjson f "$fg" '{process_info: {foreground_process_group_id: $f, shell_pid: 1}}')" ;;
  "pane run")
    pane=$1 kind=${2%% *}
    kind=${kind//\'/}
    save --arg p "$pane" --arg k "$kind" \
      '.panes[] as $q | select($q.pane_id == $p) | .agents += [{name: null, agent: $k, agent_status: "idle", pane_id: $p, tab_id: $q.tab_id, cwd: $q.cwd, foreground_cwd: $q.cwd}]'
    ok '{"type": "ok"}' ;;
  "agent list") ok "$(state '{agents: .agents}')" ;;
  "agent get")
    a=$(agent_of "$1")
    [[ $a ]] || fail agent_not_found
    ok "$(jq -c '{agent: .}' <<<"$a")" ;;
  "agent start")
    name=$1
    shift
    kind='' pane=''
    while (($#)); do
      case $1 in
        --kind) kind=$2 && shift 2 ;;
        --pane) pane=$2 && shift 2 ;;
        --timeout) shift 2 ;;
        --) shift && break ;;
        *) shift ;;
      esac
    done
    if e=$(injected FAKE_HERDR_START_ERRORS); then fail "$e"; fi
    [[ -z $(agent_of "$name") ]] || fail agent_name_taken
    [[ -z $(agent_of "$pane") ]] || fail agent_pane_busy
    sid=''
    args=("$@")
    for i in "${!args[@]}"; do
      if [[ ${args[i]} == --session-id || ${args[i]} == --resume ]]; then sid=${args[i + 1]}; fi
    done
    status=${FAKE_HERDR_START_STATUS:-idle}
    save --arg n "$name" --arg k "$kind" --arg p "$pane" --arg s "$status" --arg sid "$sid" \
      '.panes[] as $q | select($q.pane_id == $p) | .agents += [{name: $n, agent: $k, agent_status: $s, pane_id: $p, tab_id: $q.tab_id,
        cwd: $q.cwd, foreground_cwd: $q.cwd} + (if $sid == "" then {} else {agent_session: {value: $sid}} end)]'
    [[ $status != blocked ]] || fail agent_not_ready
    argv=$(printf '%s\n' "$kind" "$@" | jq -R . | jq -sc .)
    ok "$(jq -nc --argjson a "$argv" '{type: "agent_started", argv: $a}')" ;;
  "agent prompt")
    target=$1 text=$2
    a=$(agent_of "$target")
    [[ $a ]] || fail agent_not_found
    if [[ $text == /exit ]]; then
      [[ ${FAKE_HERDR_EXIT_IGNORED:-} == 1 ]] || save --arg t "$target" '.agents |= map(select(.name != $t and .pane_id != $t))'
      ok "$(jq -c '{agent: .}' <<<"$a")"
      exit 0
    fi
    printf '%s\n%s\n' "$text" '--- end of prompt ---' >>"$FAKE_DIR/prompts"
    if e=$(injected FAKE_HERDR_PROMPT_ERRORS); then fail "$e"; fi
    ok "$(jq -c '{agent: (. + {agent_status: "working"})}' <<<"$a")" ;;
  "agent wait")
    a=$(agent_of "$1")
    [[ $a ]] || fail agent_not_found
    ok "$(jq -c '{agent: .}' <<<"$a")" ;;
  "agent read") printf '%s\n' "${FAKE_HERDR_SCREEN:-}" ;;
  "agent send-keys")
    target=$1
    shift
    if [[ " $* " == *" ctrl+c "* && ${FAKE_HERDR_CTRLC_IGNORED:-} != 1 ]]; then
      save --arg t "$target" '.agents |= map(select(.name != $t and .pane_id != $t))'
    fi
    ok '{"type": "ok"}' ;;
  "agent rename")
    save --arg t "$1" --arg n "$2" '.agents |= map(if .name == $t or .pane_id == $t then .name = $n else . end)'
    ok '{"type": "ok"}' ;;
  *)
    echo "fake herdr: unsupported: $group $cmd" >&2
    exit 2 ;;
esac
