#!/usr/bin/env bash
# tkt: run the mechanical steps of the ticket lifecycle from a herdr pane.
# Usage and design: the "Scripts" section of this repository's README.

set -Eeuo pipefail
shopt -s inherit_errexit

readonly TKT_VERSION=0.1.0
readonly MAX_PROMPT_BYTES=131000
readonly CFG_DIR=${XDG_CONFIG_HOME:-$HOME/.config}/tkt
readonly LOG_FILE=${XDG_STATE_HOME:-$HOME/.local/state}/tkt/tkt.log

DRY=0
FORCE=0
VERBOSE=0
TICKET=-
OUT=
ERR=
RC=0

# ---------------------------------------------------------------- output

die() {
  local code=$1
  shift
  printf 'tkt: %s\n' "$*" >&2
  exit "$code"
}

warn() { printf 'tkt: warning: %s\n' "$*" >&2; }
info() { printf 'tkt: %s\n' "$*" >&2; }

usage() {
  cat <<'EOF'
Usage: tkt [-C DIR] [-v] COMMAND [ARGS]

Commands:
  start [ID] [--prompt TEXT|-] [--as PRESET] [--focus] [--force] [--dry-run]
      Create or reuse the ticket's worktree, open a tab named after it, start an
      agent in build mode and send it the prompt (the dispatcher's block).
  run ID STAGE [--prompt TEXT|-] [--as PRESET] [--pane PANE] [--force] [--dry-run]
      Replace the ticket's idle agent with a fresh session and send the stage
      line. Stages: address, sync, verify, ci, review, start, plus your own.
  resume ID [--session ID] [--as PRESET] [--focus] [--dry-run]
      Relaunch the ticket's newest session, with the right flags, when no agent
      runs for it.
  done [ID...] [--all] [--yes] [--dry-run]
      After the pull request is merged: close the ticket's tabs and remove its
      worktree (worktrunk deletes the branch once it is merged).
  ls [--no-fetch]
      One row per ticket worktree: agent, pull request, checks, review verdict,
      commits behind the base, and the tkt command to run next.

Global options:
  -C DIR     run as if started in DIR
  -v         print every external command to stderr
  --version  print the version

Exit codes: 0 ok, 1 external command failed, 2 usage or refused input,
3 environment or configuration, 4 refused because of the current state,
5 uncertain outcome (inspect the tab before retrying).
EOF
}

# ---------------------------------------------------------------- commands and logging

log_arg() {
  local a=$1 bytes
  if ((${#a} > 200)); then
    bytes=$(printf '%s' "$a" | wc -c)
    printf '<text %s bytes sha256:%s>' "$bytes" "$(printf '%s' "$a" | sha256sum | cut -c1-12)"
  else
    printf '%q' "$a"
  fi
}

log_cmd() {
  local rc=$1 ms=$2 line a
  shift 2
  line="$(date -u +%FT%TZ) $TICKET rc=$rc ${ms}ms"
  for a in "$@"; do line+=" $(log_arg "$a")"; done
  mkdir -p "${LOG_FILE%/*}" 2>/dev/null && printf '%s\n' "$line" >>"$LOG_FILE" 2>/dev/null || true
  if ((VERBOSE)); then printf 'tkt: + %s\n' "${line#* }" >&2; fi
}

# Runs a command and keeps stdout in OUT, stderr in ERR and the status in RC.
run() {
  local errf start
  errf=$(mktemp)
  start=$(date +%s%N)
  set +e
  OUT=$("$@" 2>"$errf")
  RC=$?
  set -e
  ERR=$(<"$errf")
  rm -f "$errf"
  log_cmd "$RC" $((($(date +%s%N) - start) / 1000000)) "$@"
}

# Like run, but stderr stays on the terminal so the user sees prompts and
# progress, and stdin is the terminal only when tkt runs interactively.
run_visible() {
  local start
  start=$(date +%s%N)
  set +e
  if [[ -t 0 ]]; then
    OUT=$("$@")
  else
    OUT=$("$@" </dev/null)
  fi
  RC=$?
  set -e
  ERR=
  log_cmd "$RC" $((($(date +%s%N) - start) / 1000000)) "$@"
}

would() {
  local a line=''
  for a in "$@"; do line+=" $(log_arg "$a")"; done
  printf 'tkt: dry run:%s\n' "$line" >&2
}

need_tools() {
  local t
  for t in "$@"; do
    command -v "$t" >/dev/null 2>&1 || die 3 "$t is not installed"
  done
}

uuid_new() {
  if [[ -r /proc/sys/kernel/random/uuid ]]; then
    cat /proc/sys/kernel/random/uuid
  else
    python3 -c 'import uuid; print(uuid.uuid4())'
  fi
}

is_inside() {
  [[ $1 == "$2" || $1 == "$2"/* ]]
}

# ---------------------------------------------------------------- repository and configuration

repo_resolve() {
  local dir=${TKT_DIR:-$PWD}
  git -C "$dir" rev-parse --git-dir >/dev/null 2>&1 || die 3 "$dir is not inside a git repository"
  ROOT=$(git -C "$dir" worktree list --porcelain | sed -n '1s/^worktree //p')
  COMMON=$(git -C "$dir" rev-parse --path-format=absolute --git-common-dir)
  [[ -d $ROOT ]] || die 3 "cannot find the primary worktree of $dir"
}

cfg_marker_ok() {
  [[ $(head -n 1 "$1") == "<!-- rogs-skills config v1: $2 -->" ]]
}

forge_field() {
  sed -n '/^## Forge$/,/^## /p' "$FORGE_FILE" | sed -n "s/^- $1: *//p" | head -n 1 |
    cut -d ';' -f 1 | tr -d '`' | sed 's/[[:space:].]*$//'
}

cfg_load() {
  local tracker=$ROOT/docs/agents/issue-tracker.md line
  FORGE_FILE=$ROOT/docs/agents/forge.md
  [[ -f $tracker && -f $FORGE_FILE ]] || die 3 "$ROOT/docs/agents has no lifecycle configuration; run /setup-rogs"
  cfg_marker_ok "$tracker" issue-tracker || die 3 "$tracker is not a rogs-skills config v1 file; run /setup-rogs"
  cfg_marker_ok "$FORGE_FILE" forge || die 3 "$FORGE_FILE is not a rogs-skills config v1 file; run /setup-rogs"
  line=$(grep -m 1 '^- Ticket ids:' "$tracker" || true)
  # shellcheck disable=SC2016 # backticks and $ are literal here
  TICKET_RE=$(grep -o '`\^[^`]*\$`' <<<"$line" | head -n 1 | tr -d '`' || true)
  [[ $TICKET_RE ]] || die 3 "$tracker: no ticket id pattern (a backticked ^...\$) on the '- Ticket ids:' line"
  TICKET_PREFIX=
  if [[ $TICKET_RE =~ ^\^([A-Za-z][A-Za-z0-9]*)- ]]; then TICKET_PREFIX=${BASH_REMATCH[1]}; fi
  FORGE_KIND=$(forge_field Kind)
  FORGE_HOST=$(forge_field Host)
  FORGE_REPO=$(forge_field Repository)
  REMOTE=$(forge_field Remote)
  BASE=$(forge_field 'Base branch')
  [[ $REMOTE && $BASE ]] || die 3 "$FORGE_FILE: '## Forge' needs '- Remote:' and '- Base branch:' lines"
}

need_github() {
  [[ $FORGE_KIND == GitHub ]] || die 3 "tkt $1 supports GitHub forges only; this repository's forge is ${FORGE_KIND:-not set}"
  [[ $FORGE_HOST && $FORGE_REPO ]] || die 3 "$FORGE_FILE: '## Forge' needs '- Host:' and '- Repository:' lines"
  need_tools gh
  GH_REPO=$FORGE_HOST/$FORGE_REPO
}

normalize_id() {
  local id=$1 up
  if [[ $id =~ ^[0-9]+$ && $TICKET_PREFIX ]]; then id=$TICKET_PREFIX-$id; fi
  if [[ ! $id =~ $TICKET_RE ]]; then
    up=${id^^}
    if [[ $up =~ $TICKET_RE ]]; then id=$up; fi
  fi
  [[ $id =~ $TICKET_RE ]] || die 2 "'$1' is not a ticket id (expected $TICKET_RE)"
  printf '%s' "$id"
}

agent_name_for() {
  local n=${1,,}
  n=${n//[^a-z0-9_-]/-}
  if [[ $n != [a-z]* ]]; then n=t-$n; fi
  printf '%s' "${n:0:32}"
}

# ---------------------------------------------------------------- presets and stage lines

declare -ga P_ORDER=()
declare -gA P_HARNESS=() P_MODEL=() P_SERVES=()
declare -gA STAGE_TEXT=()

presets_load() {
  local f=$CFG_DIR/presets src name harness model serves extra
  if [[ -f $f ]]; then
    src=$(<"$f")
  else
    f="built-in presets"
    src=$'claude claude - *\nopencode opencode - *'
  fi
  P_ORDER=()
  while read -r name harness model serves extra; do
    if [[ -z $name || $name == '#'* ]]; then continue; fi
    [[ $harness == claude || $harness == opencode ]] || die 3 "$f: preset '$name': the harness must be claude or opencode"
    [[ $model ]] || die 3 "$f: preset '$name': missing the model column (use - for the default)"
    [[ -z $extra ]] || die 3 "$f: preset '$name': too many columns"
    [[ -z ${P_HARNESS[$name]+x} ]] || die 3 "$f: preset '$name' is defined twice"
    P_ORDER+=("$name")
    P_HARNESS[$name]=$harness
    P_MODEL[$name]=$model
    P_SERVES[$name]=${serves:-*}
  done <<<"$src"
  ((${#P_ORDER[@]})) || die 3 "$f: no presets"
}

preset_known() {
  [[ ${P_HARNESS[$1]+x} ]] || die 2 "unknown preset '$1' (presets: ${P_ORDER[*]})"
}

preset_serves() {
  local s
  IFS=, read -ra s <<<"${P_SERVES[$1]}"
  local x
  for x in "${s[@]}"; do
    if [[ $x == '*' || $x == "$2" ]]; then return 0; fi
  done
  return 1
}

prompt_model_values() {
  { grep -oE 'Model:[[:space:]]*`?[A-Za-z0-9._-]+' <<<"$1" || true; } |
    sed -E 's/^Model:[[:space:]]*`?//; s/\.+$//' | sort -u
}

# Sets PRESET from --as, or from the prompt's "Model:" values.
preset_pick() {
  local as=$1 prompt=$2 v p
  local -a values
  mapfile -t values < <(prompt_model_values "$prompt")
  if [[ $as ]]; then
    preset_known "$as"
    for v in "${values[@]}"; do
      if ! preset_serves "$as" "$v" && ((!FORCE)); then
        die 2 "the prompt says 'Model: $v', which preset '$as' does not serve; pass --force to use it anyway"
      fi
    done
    PRESET=$as
    return 0
  fi
  if ((${#values[@]} > 1)); then die 2 "the prompt names several models (${values[*]}); pass --as"; fi
  if ((${#values[@]} == 0)); then
    PRESET=${P_ORDER[0]}
    return 0
  fi
  for p in "${P_ORDER[@]}"; do
    if preset_serves "$p" "${values[0]}"; then
      PRESET=$p
      return 0
    fi
  done
  die 2 "no preset serves 'Model: ${values[0]}'; add one to $CFG_DIR/presets or pass --as"
}

stages_load() {
  local f=$CFG_DIR/stages name text
  STAGE_TEXT=(
    [start]="Use the start-ticket skill to start ticket {id}."
    [address]="Use the address-pr-review skill to address the review on this branch's pull request."
    [sync]="Use the address-pr-review skill to sync the PR with the base."
    [verify]="Run every step of the Human verification section of this branch's pull request with the playwright-cli skill. Report each step as passed or failed with what you saw. Change no code and post nothing."
    [ci]="The checks on this branch's pull request fail at its head. Find the cause and fix it, then push once. When a failure is infrastructure, such as an API quota error, rerun the job instead of changing code."
    [review]="Use the review-pr skill to review the current PR."
  )
  [[ -f $f ]] || return 0
  while read -r name text; do
    if [[ -z $name || $name == '#'* ]]; then continue; fi
    [[ $text ]] || die 3 "$f: stage '$name' has no text"
    STAGE_TEXT[$name]=$text
  done <"$f"
}

stage_line() {
  local t=${STAGE_TEXT[$1]-}
  [[ $t ]] || die 2 "unknown stage '$1' (stages: $(printf '%s\n' "${!STAGE_TEXT[@]}" | sort | xargs))"
  printf '%s' "${t//\{id\}/$2}"
}

# ---------------------------------------------------------------- prompts

prompt_read() {
  if [[ $1 != - ]]; then
    PROMPT=$1
    return 0
  fi
  if [[ -t 0 ]]; then info "reading the prompt from the terminal; finish with Ctrl-D"; fi
  PROMPT=$(cat)
  if [[ -t 0 ]] && awk 'length($0) >= 4095 { found = 1 } END { exit !found }' <<<"$PROMPT"; then
    warn "a line of 4095 bytes or more was typed into the terminal and may be cut; pipe the prompt instead"
  fi
}

prompt_guard() {
  local p=$1 bytes
  bytes=$(printf '%s' "$p" | wc -c)
  ((bytes <= MAX_PROMPT_BYTES)) || die 2 "the prompt is $bytes bytes; the limit is $MAX_PROMPT_BYTES, because one argument must stay under 128 KiB"
  [[ $p =~ [^[:space:]] ]] || die 2 "the prompt is empty"
  ((FORCE)) && return 0
  if [[ $p == '!'* ]]; then die 2 "the prompt starts with '!', which switches the agent to shell mode; pass --force to send it anyway"; fi
  if [[ $p == /* && $p == *$'\n'* ]]; then die 2 "the prompt starts with '/' and has several lines, so the agent would read its first line as a command; pass --force to send it anyway"; fi
  return 0
}

prompt_first_id() {
  printf '%s' "$1" | tr -c 'A-Za-z0-9-' '\n' | { grep -m 1 -E -- "$TICKET_RE" || true; }
}

# ---------------------------------------------------------------- per-ticket state, locks

declare -gA ST=()

state_file() {
  printf '%s/tkt/state' "$(git -C "$1" rev-parse --absolute-git-dir)"
}

state_read() {
  local f k v
  ST=()
  f=$(state_file "$1")
  [[ -f $f ]] || return 0
  while IFS='=' read -r k v; do
    if [[ $k ]]; then ST[$k]=$v; fi
  done <"$f"
}

state_write() {
  local path=$1 f tmp kv k
  shift
  for kv in "$@"; do ST[${kv%%=*}]=${kv#*=}; done
  ((DRY)) && return 0
  ST[updated]=$(date -u +%FT%TZ)
  f=$(state_file "$path")
  mkdir -p "${f%/*}"
  tmp=$(mktemp "$f.XXXXXX")
  for k in "${!ST[@]}"; do printf '%s=%s\n' "$k" "${ST[$k]}"; done | sort >"$tmp"
  mv "$tmp" "$f"
}

lock_ticket() {
  ((DRY)) && return 0
  mkdir -p "$COMMON/tkt/locks"
  exec {TICKET_LOCK_FD}>"$COMMON/tkt/locks/$1.lock"
  flock -n "$TICKET_LOCK_FD" || die 4 "another tkt command is working on $1"
}

# ---------------------------------------------------------------- worktrunk

# Prints "branch<TAB>path<TAB>mismatch" for every worktree, from either
# `wt list --format json` schema.
wt_entries() {
  run wt -C "$ROOT" list --format json
  ((RC == 0)) || die 1 "wt list failed: $ERR"
  jq -r '
    (if type == "array" then .[] | {branch, path, mismatch: false}
     elif .schema == 2 then .items[] | {branch, path: .worktree.path, mismatch: (.worktree.branch_mismatch // false)}
     else error("unknown wt list output") end)
    | select(.path != null and .branch != null)
    | [.branch, .path, (.mismatch | tostring)] | @tsv' <<<"$OUT" || die 1 "cannot read wt list output"
}

wt_path_for() {
  wt_entries | awk -F '\t' -v b="$1" '$1 == b { print $2; exit }'
}

ticket_worktrees() {
  local branch path mismatch
  while IFS=$'\t' read -r branch path mismatch; do
    if [[ $branch =~ $TICKET_RE && ${path##*/} == "$branch" ]]; then printf '%s\t%s\n' "$branch" "$path"; fi
  done < <(wt_entries)
}

ticket_path() {
  local p
  p=$(wt_path_for "$1")
  [[ $p ]] || die 4 "$1 has no worktree; run tkt start $1"
  printf '%s' "$p"
}

# Sets WT_PATH to the ticket's worktree, creating it when needed.
wt_resolve_or_create() {
  local id=$1 create=1 lock_fd
  WT_PATH=$(wt_path_for "$id")
  if [[ $WT_PATH ]]; then
    info "reusing worktree $WT_PATH"
  elif git -C "$ROOT" show-ref --verify --quiet "refs/heads/$id"; then
    if ((!FORCE)); then
      die 4 "branch $id exists without a worktree ($(git -C "$ROOT" log -1 --format='%h %s' "$id")); it may be a finished ticket. Reuse it with --force, or delete it with: git branch -d $id"
    fi
    create=0
  else
    run timeout 20 git -C "$ROOT" ls-remote --heads "$REMOTE" "$id"
    if ((RC != 0)); then
      warn "cannot reach $REMOTE to look for an existing $id branch; creating it from $BASE"
    elif [[ $OUT ]]; then
      info "branch $id exists on $REMOTE; checking it out"
      create=0
    elif git -C "$ROOT" show-ref --verify --quiet "refs/remotes/$REMOTE/$id"; then
      die 4 "refs/remotes/$REMOTE/$id is stale (the branch is gone from $REMOTE, so the ticket may be merged); run git fetch --prune $REMOTE first"
    fi
  fi
  if [[ -z $WT_PATH ]]; then
    run wt -C "$ROOT" hook show
    if [[ $OUT == *post-start* ]]; then warn "worktrunk runs post-start hooks in the background, so the agent may start before they finish; move readiness work to pre-start"; fi
    local -a args=(-C "$ROOT" switch)
    ((create)) && args+=(--create)
    args+=("$id" --no-cd --format json)
    if ((DRY)); then
      would wt "${args[@]}"
      WT_PATH="<worktree of $id>"
      return 0
    fi
    mkdir -p "$COMMON/tkt/locks"
    exec {lock_fd}>"$COMMON/tkt/locks/wt.lock"
    flock -w 300 "$lock_fd" || die 4 "timed out waiting for another tkt start to finish creating its worktree"
    run_visible wt "${args[@]}"
    exec {lock_fd}>&-
    if ((RC != 0)); then
      WT_PATH=$(wt_path_for "$id")
      if [[ $WT_PATH ]]; then
        die 1 "wt created $WT_PATH but a hook failed (see above). Fix it, run 'wt -C $WT_PATH hook pre-start', then rerun tkt start $id"
      fi
      die 1 "wt switch failed for $id (see above)"
    fi
    WT_PATH=$(wt_path_for "$id")
    [[ $WT_PATH ]] || die 1 "wt reported success but lists no worktree for $id"
  fi
  local mismatch
  mismatch=$(wt_entries | awk -F '\t' -v b="$id" '$1 == b { print $3; exit }')
  [[ ${WT_PATH##*/} == "$id" ]] || die 3 "the worktree directory is ${WT_PATH##*/}, not $id; the lifecycle skills need branch = directory = ticket id (check worktree-path in your worktrunk config)"
  [[ $(git -C "$WT_PATH" branch --show-current) == "$id" && $mismatch != true ]] || die 3 "$WT_PATH is not on branch $id"
}

# ---------------------------------------------------------------- herdr

need_herdr() {
  [[ ${HERDR_ENV:-} == 1 && ${HERDR_WORKSPACE_ID:-} ]] || die 3 "run tkt from a herdr pane (HERDR_ENV is not set)"
  need_tools herdr
}

herdr_code() {
  jq -r '.error.code // empty' <<<"$ERR" 2>/dev/null || true
}

herdr_json() {
  run herdr "$@"
  ((RC == 0)) || die 1 "herdr $*: $(herdr_code) ${ERR:0:200}"
  printf '%s' "$OUT"
}

agents_json() { herdr_json agent list | jq -c '.result.agents'; }
panes_json() { herdr_json pane list | jq -c '.result.panes'; }

tabs_json() {
  local ws
  for ws in $(herdr_json workspace list | jq -r '.result.workspaces[].workspace_id'); do
    herdr_json tab list --workspace "$ws" | jq -c '.result.tabs[]'
  done | jq -s -c .
}

# Tabs whose label is ID or starts with "ID ", from a tabs_json array.
ticket_tabs() {
  jq -c --arg id "$1" '[.[] | select(.label == $id or (.label | startswith($id + " ")))]' <<<"$2"
}

agents_in_path() {
  jq -c --arg p "$1" '[.[] | select((.cwd // "") as $c | (.foreground_cwd // "") as $f
      | $c == $p or ($c | startswith($p + "/")) or $f == $p or ($f | startswith($p + "/")))]' <<<"$2"
}

agent_on_pane() {
  local p=$1
  herdr agent list 2>/dev/null | jq -c --arg p "$p" '[.result.agents[] | select(.pane_id == $p)][0] // empty' 2>/dev/null || true
}

pane_is_shell() {
  herdr pane process-info --pane "$1" 2>/dev/null |
    jq -e '.result.process_info | .foreground_process_group_id == .shell_pid' >/dev/null 2>&1
}

pane_free() {
  pane_is_shell "$1" && [[ -z $(agent_on_pane "$1") ]]
}

wait_pane_free() {
  local pane=$1 tries=$2 i
  for ((i = 0; i < tries; i++)); do
    if pane_free "$pane"; then return 0; fi
    sleep 0.25
  done
  return 1
}

# Quotes words for the user's interactive shell. Single quotes mean the same
# in fish, bash and zsh as long as the word holds no quote or backslash.
shell_words() {
  local w line=''
  for w in "$@"; do
    if [[ $w == *[\'\\$'\n']* ]]; then return 1; fi
    line+=" '$w'"
  done
  printf '%s' "${line# }"
}

# Starts an agent in an idle shell pane. Returns 0 when it is ready, 2 when it
# is blocked at startup (a trust or update dialog), 1 on failure (LAUNCH_ERR).
launch_agent() {
  local pane=$1 name=$2 harness=$3 deadline code cmd agent i status
  shift 3
  LAUNCH_ERR=
  if ((DRY)); then
    would herdr agent start "$name" --kind "$harness" --pane "$pane" --timeout 90000 -- "$@"
    return 0
  fi
  deadline=$((SECONDS + 3))
  while :; do
    run herdr agent start "$name" --kind "$harness" --pane "$pane" --timeout 90000 -- "$@"
    ((RC == 0)) && return 0
    code=$(herdr_code)
    case $code in
      agent_not_ready) return 2 ;;
      agent_pane_busy)
        if ((SECONDS < deadline)); then
          sleep 0.25
          continue
        fi
        break
        ;;
      *)
        LAUNCH_ERR="herdr agent start: ${code:-${ERR:0:200}}"
        return 1
        ;;
    esac
  done
  # herdr also calls a pane busy when the shell keeps a zombie child in its
  # foreground process group, which fish sometimes does; typing works there.
  pane_is_shell "$pane" || {
    LAUNCH_ERR="pane $pane is not at a shell prompt"
    return 1
  }
  cmd=$(shell_words "$harness" "$@") || {
    LAUNCH_ERR="cannot quote the launch command for the shell"
    return 1
  }
  info "herdr reports pane $pane busy; typing the command into its shell instead"
  run herdr pane run "$pane" "$cmd"
  ((RC == 0)) || {
    LAUNCH_ERR="herdr pane run: $(herdr_code)"
    return 1
  }
  for ((i = 0; i < 80; i++)); do
    agent=$(agent_on_pane "$pane")
    [[ $agent ]] && break
    sleep 0.25
  done
  [[ $agent ]] || {
    LAUNCH_ERR="no agent appeared in pane $pane"
    return 1
  }
  run herdr agent wait "$pane" --until idle --until blocked --until 'done' --timeout 90000
  ((RC == 0)) || {
    LAUNCH_ERR="the agent in pane $pane did not become ready: $(herdr_code)"
    return 1
  }
  status=$(jq -r '.result.agent.agent_status // empty' <<<"$OUT" 2>/dev/null || true)
  run herdr agent rename "$pane" "$name"
  ((RC == 0)) || warn "could not name the agent in pane $pane '$name'"
  [[ $status == blocked ]] && return 2
  return 0
}

# Sends text to an agent. Returns 0 once the agent starts working, 5 when the
# outcome is unknown (never resend then), 1 on failure.
send_prompt() {
  local name=$1 text=$2
  if ((DRY)); then
    would herdr agent prompt "$name" "$text" --wait --until working --until blocked --timeout 60000
    return 0
  fi
  run herdr agent prompt "$name" "$text" --wait --until working --until blocked --timeout 60000
  ((RC == 0)) && return 0
  case $(herdr_code) in
    agent_prompt_stalled | timeout) return 5 ;;
    *) return 1 ;;
  esac
}

# Exits the idle agent in a pane and waits until herdr sees a free shell.
exit_agent() {
  local pane=$1 i
  if ((DRY)); then
    would herdr agent prompt "$pane" /exit
    return 0
  fi
  run herdr agent prompt "$pane" /exit
  for ((i = 0; i < 25; i++)); do
    pane_is_shell "$pane" && break
    sleep 0.2
  done
  # /exit only works on an empty input box; Ctrl-C clears it, then exits.
  for ((i = 0; i < 3; i++)); do
    pane_is_shell "$pane" && break
    run herdr agent send-keys "$pane" ctrl+c
    sleep 0.7
  done
  wait_pane_free "$pane" 40
}

show_screen() {
  info "the agent's screen:"
  herdr agent read "$1" --source visible --lines 25 2>/dev/null | grep -v '^[[:space:]]*$' | tail -n 15 >&2 || true
}

# ---------------------------------------------------------------- harness adapters

claude_args() {
  local -n _args=$1
  local mode=$2 sid=$3 spec=${P_MODEL[$4]} model effort=''
  if [[ $mode == resume ]]; then
    _args=(--resume "$sid" --dangerously-skip-permissions)
  else
    _args=(--dangerously-skip-permissions --session-id "$sid")
  fi
  [[ $spec == - ]] && return 0
  model=${spec%%#*}
  if [[ $spec == *'#'* ]]; then effort=${spec#*#}; fi
  if [[ $model ]]; then _args+=(--model "$model"); fi
  if [[ $effort ]]; then _args+=(--effort "$effort"); fi
}

oc_model_json() {
  local spec=$1 provider rest id variant=''
  if [[ $spec == - ]]; then
    printf 'null'
    return 0
  fi
  [[ $spec == */* ]] || die 3 "OpenCode model '$spec' must look like provider/model or provider/model#variant"
  provider=${spec%%/*}
  rest=${spec#*/}
  id=${rest%%#*}
  if [[ $rest == *'#'* ]]; then variant=${rest#*#}; fi
  jq -nc --arg p "$provider" --arg i "$id" --arg v "$variant" '{providerID: $p, id: $i} + (if $v == "" then {} else {variant: $v} end)'
}

oc_api() {
  run timeout 60 opencode api "$@"
  if ((RC != 0)); then
    run timeout 30 opencode service start
    run timeout 60 opencode api "$@"
  fi
  ((RC == 0)) || die 1 "opencode api $1 $2 failed: ${ERR:0:200}"
}

# Creates an OpenCode session on the build agent with the preset's model and
# prints its id; `opencode -s <id> <dir>` then opens it.
oc_session_create() {
  local path=$1 title=$2 preset=$3 body sid
  body=$(jq -nc --arg d "$path" --arg t "$title" --argjson m "$(oc_model_json "${P_MODEL[$preset]}")" \
    '{title: $t, agent: "build", location: {directory: $d}} + (if $m == null then {} else {model: $m} end)')
  if ((DRY)); then
    would opencode api POST /api/session -d "$body"
    printf 'ses_dryrun'
    return 0
  fi
  oc_api POST /api/session -d "$body"
  sid=$(jq -r '.data.id // .id // empty' <<<"$OUT")
  [[ $sid == ses* ]] || die 1 "opencode did not return a session id: ${OUT:0:200}"
  printf '%s' "$sid"
}

oc_session_active() {
  run timeout 30 opencode api GET /api/session/active
  ((RC == 0)) && jq -e --arg s "$1" '.data | has($s)' <<<"$OUT" >/dev/null 2>&1
}

# Prints "<updated ms> <session id>" for the newest Claude session of a path.
claude_newest_session() {
  local dir
  dir=${CLAUDE_CONFIG_DIR:-$HOME/.claude}/projects/$(printf '%s' "$1" | sed 's/[^A-Za-z0-9]/-/g')
  [[ -d $dir ]] || return 0
  find "$dir" -maxdepth 1 -name '*.jsonl' -printf '%T@ %f\n' | sort -nr | head -n 1 |
    awk '{ split($1, t, "."); printf "%d %s\n", t[1] * 1000 + substr(t[2] "000", 1, 3), substr($2, 1, length($2) - 6) }'
}

# Prints "<updated ms> <session id>" for the newest top-level OpenCode session
# of a path, skipping plan-review sessions.
oc_newest_session() {
  local path=$1 uri
  command -v opencode >/dev/null 2>&1 || return 0
  uri=$(jq -rn --arg d "$path" '$d | @uri')
  run timeout 60 opencode api GET "/api/session?directory=$uri&order=desc&limit=20"
  ((RC == 0)) || return 0
  jq -r --arg d "$path" '[.data[]? | select((.parentID // null) == null and .agent != "plan-review"
      and (.location.directory // "") == $d)][0] // empty | "\(.time.updated) \(.id)"' <<<"$OUT" 2>/dev/null || true
}

# Prints the launch arguments, one per line, for a phase (new or resume).
launch_args() {
  local harness=$1 phase=$2 sid=$3 preset=$4 path=$5
  local -a a
  if [[ $harness == claude ]]; then
    claude_args a "$phase" "$sid" "$preset"
  else
    a=(-s "$sid" "$path")
  fi
  printf '%s\n' "${a[@]}"
}

# ---------------------------------------------------------------- pane selection for run and resume

# Sets PANE and TAB for a ticket: --pane, the recorded pane, the agent running
# in the worktree, then the ticket tab's first pane. Creates a tab when none.
pick_pane() {
  local id=$1 path=$2 want=$3 agents tabs mine count label
  agents=$(agents_in_path "$path" "$(agents_json)")
  PANE=
  TAB=
  if [[ $want ]]; then
    PANE=$want
  elif [[ ${ST[pane]-} ]] && herdr pane get "${ST[pane]}" >/dev/null 2>&1; then
    PANE=${ST[pane]}
  else
    count=$(jq length <<<"$agents")
    if ((count > 1)); then die 4 "$count agents run in $path; pick one with --pane ($(jq -r '[.[].pane_id] | join(", ")' <<<"$agents"))"; fi
    if ((count == 1)); then PANE=$(jq -r '.[0].pane_id' <<<"$agents"); fi
  fi
  tabs=$(tabs_json)
  if [[ -z $PANE ]]; then
    mine=$(ticket_tabs "$id" "$tabs")
    count=$(jq length <<<"$mine")
    if ((count > 1)); then die 4 "$count tabs belong to $id; pick a pane with --pane"; fi
    if ((count == 1)); then
      TAB=$(jq -r '.[0].tab_id' <<<"$mine")
      PANE=$(panes_json | jq -r --arg t "$TAB" '[.[] | select(.tab_id == $t)][0].pane_id // empty')
    fi
  fi
  if [[ $PANE ]]; then
    TAB=$(herdr_json pane get "$PANE" | jq -r '.result.pane.tab_id // .result.tab_id')
    local cwd
    cwd=$(herdr_json pane get "$PANE" | jq -r '.result.pane.cwd // .result.cwd // empty')
    is_inside "$cwd" "$path" || die 4 "pane $PANE is in $cwd, not in $path"
    [[ $PANE != "${HERDR_PANE_ID:-}" ]] || die 4 "pane $PANE is the one running tkt"
    return 0
  fi
  label=$(tab_label "$id" "$PRESET")
  if ((DRY)); then
    would herdr tab create --workspace "$HERDR_WORKSPACE_ID" --cwd "$path" --label "$label" --no-focus
    TAB="<tab>"
    PANE="<pane>"
    return 0
  fi
  OUT=$(herdr_json tab create --workspace "$HERDR_WORKSPACE_ID" --cwd "$path" --label "$label" --no-focus)
  TAB=$(jq -r '.result.tab.tab_id' <<<"$OUT")
  PANE=$(jq -r '.result.root_pane.pane_id' <<<"$OUT")
  wait_pane_free "$PANE" 40 || true
}

tab_label() {
  if [[ $2 == "${P_ORDER[0]}" ]]; then
    printf '%s' "$1"
  else
    printf '%s (%s)' "$1" "$2"
  fi
}

own_commits() {
  if git -C "$1" rev-parse --verify --quiet "refs/remotes/$REMOTE/$BASE" >/dev/null; then
    git -C "$1" rev-list --count "refs/remotes/$REMOTE/$BASE..HEAD"
  else
    printf '0'
  fi
}

worktree_clean() {
  [[ -z $(git -C "$1" status --porcelain=v1) ]]
}

# ---------------------------------------------------------------- tkt start

cmd_start() {
  local id='' prompt_set=0 as='' focus=0
  PROMPT=
  while (($#)); do
    case $1 in
      --prompt)
        (($# >= 2)) || die 2 "--prompt needs a value (text, or - for stdin)"
        prompt_read "$2"
        prompt_set=1
        shift 2
        ;;
      --as)
        (($# >= 2)) || die 2 "--as needs a preset name"
        as=$2
        shift 2
        ;;
      --focus) focus=1 && shift ;;
      --force) FORCE=1 && shift ;;
      --dry-run) DRY=1 && shift ;;
      -h | --help) usage && return 0 ;;
      -*) die 2 "start: unknown option $1" ;;
      *)
        [[ -z $id ]] || die 2 "start takes one ticket id"
        id=$1
        shift
        ;;
    esac
  done
  need_tools git jq wt flock timeout
  repo_resolve
  cfg_load
  presets_load
  stages_load
  if ((prompt_set)); then prompt_guard "$PROMPT"; fi

  local from_prompt=''
  if ((prompt_set)); then from_prompt=$(prompt_first_id "$PROMPT"); fi
  if [[ $id ]]; then
    id=$(normalize_id "$id")
    if [[ $from_prompt && $from_prompt != "$id" ]] && ((!FORCE)); then
      die 2 "you asked for $id but the prompt's first ticket is $from_prompt; pass --force to start $id with it"
    fi
  else
    [[ $from_prompt ]] || die 2 "give a ticket id, or a prompt that names one"
    id=$from_prompt
    info "ticket $id (the first id in the prompt)"
  fi
  TICKET=$id
  preset_pick "$as" "$PROMPT"
  local harness=${P_HARNESS[$PRESET]} name
  name=$(agent_name_for "$id")
  if ((!prompt_set)); then PROMPT=$(stage_line start "$id"); fi

  need_herdr
  need_tools "$harness"
  lock_ticket "$id"
  wt_resolve_or_create "$id"
  local path=$WT_PATH

  local agents tabs mine tab='' pane='' continuing=0
  if ((DRY)) && [[ $path == '<'* ]]; then
    agents='[]'
  else
    state_read "$path"
    agents=$(agents_in_path "$path" "$(agents_json)")
  fi
  if [[ ${ST[status]-} == not_ready ]] &&
    jq -e --arg p "${ST[pane]-}" 'length == 1 and .[0].pane_id == $p and (.[0].agent_status | IN("idle", "done"))' <<<"$agents" >/dev/null; then
    info "continuing the start that stopped at the agent's startup dialog"
    continuing=1
    tab=${ST[tab]}
    pane=${ST[pane]}
    name=${ST[agent]}
    PRESET=${ST[preset]}
    harness=${ST[harness]}
  elif [[ $(jq length <<<"$agents") != 0 ]]; then
    die 4 "an agent already runs in $path (pane $(jq -r '.[0].pane_id' <<<"$agents")); use tkt run or tkt resume"
  fi

  if ((!continuing)); then
    local label
    label=$(tab_label "$id" "$PRESET")
    tabs=$(tabs_json)
    mine=$(jq -c --arg w "$HERDR_WORKSPACE_ID" '[.[] | select(.workspace_id == $w)]' <<<"$(ticket_tabs "$id" "$tabs")")
    if [[ $(jq length <<<"$mine") != 0 ]]; then
      tab=$(jq -r '.[0].tab_id' <<<"$mine")
      local tab_panes
      tab_panes=$(panes_json | jq -c --arg t "$tab" '[.[] | select(.tab_id == $t)]')
      jq -e --arg p "$path" 'all(.[]; (.agent // null) == null and .cwd == $p)' <<<"$tab_panes" >/dev/null ||
        die 4 "tab '$(jq -r '.[0].label' <<<"$mine")' already belongs to $id; use tkt run or tkt resume, or close it"
      pane=$(jq -r '.[0].pane_id' <<<"$tab_panes")
      pane_is_shell "$pane" || die 4 "tab '$(jq -r '.[0].label' <<<"$mine")' is busy"
      info "reusing tab $tab"
    elif ((DRY)); then
      would herdr tab create --workspace "$HERDR_WORKSPACE_ID" --cwd "$path" --label "$label" --no-focus
      tab="<tab>"
      pane="<pane>"
    else
      OUT=$(herdr_json tab create --workspace "$HERDR_WORKSPACE_ID" --cwd "$path" --label "$label" --no-focus)
      tab=$(jq -r '.result.tab.tab_id' <<<"$OUT")
      pane=$(jq -r '.result.root_pane.pane_id' <<<"$OUT")
    fi
    state_write "$path" ticket="$id" preset="$PRESET" harness="$harness" stage=start tab="$tab" pane="$pane" agent="$name" status=tab
    if ((!DRY)); then
      wait_pane_free "$pane" 40 || true
      local cwd
      cwd=$(herdr_json pane get "$pane" | jq -r '.result.pane.cwd // .result.cwd // empty')
      [[ $cwd == "$path" ]] || die 4 "the new pane opened in $cwd instead of $path"
    fi

    local sid
    if [[ $harness == claude ]]; then sid=$(uuid_new); else sid=$(oc_session_create "$path" "$id" "$PRESET"); fi
    state_write "$path" session="$sid" status=launching
    local -a largs
    mapfile -t largs < <(launch_args "$harness" new "$sid" "$PRESET" "$path")
    local rc=0
    launch_agent "$pane" "$name" "$harness" "${largs[@]}" || rc=$?
    if ((rc == 2)); then
      state_write "$path" status=not_ready
      show_screen "$pane"
      die 5 "the agent stopped at a startup dialog in tab $tab; answer it there, then rerun: tkt start $id (with the same prompt)"
    fi
    ((rc == 0)) || die 1 "$LAUNCH_ERR"
  fi

  local prc=0
  send_prompt "$pane" "$PROMPT" || prc=$?
  if ((prc == 5)); then
    state_write "$path" status=prompt_uncertain
    show_screen "$pane"
    die 5 "cannot confirm the agent received the prompt; check tab $tab before sending it again"
  fi
  ((prc == 0)) || die 1 "sending the prompt failed: $(herdr_code) ${ERR:0:200}"
  state_write "$path" status=submitted
  if ((focus && !DRY)); then herdr_json tab focus "$tab" >/dev/null; fi
  printf '%s  %s  tab %s  agent %s (%s, %s)\n' "$id" "$path" "$tab" "$name" "$PRESET" "$harness"
}

# ---------------------------------------------------------------- tkt run

cmd_run() {
  local id='' stage='' text='' text_set=0 as='' want_pane=''
  while (($#)); do
    case $1 in
      --prompt)
        (($# >= 2)) || die 2 "--prompt needs a value (text, or - for stdin)"
        prompt_read "$2"
        text=$PROMPT
        text_set=1
        shift 2
        ;;
      --as)
        (($# >= 2)) || die 2 "--as needs a preset name"
        as=$2
        shift 2
        ;;
      --pane)
        (($# >= 2)) || die 2 "--pane needs a pane id"
        want_pane=$2
        shift 2
        ;;
      --force) FORCE=1 && shift ;;
      --dry-run) DRY=1 && shift ;;
      -h | --help) usage && return 0 ;;
      -*) die 2 "run: unknown option $1" ;;
      *)
        if [[ -z $id ]]; then
          id=$1
        elif [[ -z $stage ]]; then
          stage=$1
        else
          die 2 "run takes a ticket id and a stage"
        fi
        shift
        ;;
    esac
  done
  [[ $id ]] || die 2 "usage: tkt run ID STAGE"
  [[ $stage || $text_set == 1 ]] || die 2 "usage: tkt run ID STAGE (or --prompt TEXT)"
  need_tools git jq wt flock timeout
  repo_resolve
  cfg_load
  presets_load
  stages_load
  id=$(normalize_id "$id")
  TICKET=$id
  if ((!text_set)); then text=$(stage_line "$stage" "$id"); fi
  prompt_guard "$text"
  need_herdr
  local path
  path=$(ticket_path "$id")
  state_read "$path"
  if [[ $as ]]; then
    preset_known "$as"
    PRESET=$as
  elif [[ ${ST[preset]-} && ${P_HARNESS[${ST[preset]}]+x} ]]; then
    PRESET=${ST[preset]}
  else
    PRESET=${P_ORDER[0]}
  fi
  local harness=${P_HARNESS[$PRESET]} name
  name=$(agent_name_for "$id")
  need_tools "$harness"

  if [[ ${ST[stage]-} == start ]] && (($(own_commits "$path") == 0)) && worktree_clean "$path" && ((!FORCE)); then
    die 4 "$id is still in planning (no commits yet); its agent may be waiting for plan approval. Pass --force to replace it"
  fi
  lock_ticket "$id"
  pick_pane "$id" "$path" "$want_pane"

  local agent status
  agent=$(agent_on_pane "$PANE")
  if [[ $agent ]]; then
    status=$(jq -r .agent_status <<<"$agent")
    case $status in
      idle | done) ;;
      working | blocked) die 4 "the agent in pane $PANE is $status; wait for it or answer it first" ;;
      *) ((FORCE)) || die 4 "the agent in pane $PANE is in state '$status'; pass --force to replace it" ;;
    esac
    if [[ ${ST[harness]-} == opencode && ${ST[session]-} ]] && oc_session_active "${ST[session]}"; then
      die 4 "OpenCode still works on session ${ST[session]}"
    fi
    exit_agent "$PANE" || die 5 "the agent in pane $PANE did not exit; nothing was sent"
  elif ((!DRY)) && ! pane_is_shell "$PANE"; then
    die 4 "pane $PANE is not at a shell prompt"
  fi

  local sid
  if [[ $harness == claude ]]; then sid=$(uuid_new); else sid=$(oc_session_create "$path" "$id ${stage:-custom}" "$PRESET"); fi
  state_write "$path" ticket="$id" preset="$PRESET" harness="$harness" stage="${stage:-custom}" tab="$TAB" pane="$PANE" agent="$name" session="$sid" status=launching
  local -a largs
  mapfile -t largs < <(launch_args "$harness" new "$sid" "$PRESET" "$path")
  local rc=0
  launch_agent "$PANE" "$name" "$harness" "${largs[@]}" || rc=$?
  if ((rc == 2)); then
    state_write "$path" status=not_ready
    show_screen "$PANE"
    die 5 "the agent stopped at a startup dialog in pane $PANE; answer it, then send the stage line yourself"
  fi
  ((rc == 0)) || die 1 "$LAUNCH_ERR"
  local prc=0
  send_prompt "$PANE" "$text" || prc=$?
  if ((prc == 5)); then
    state_write "$path" status=prompt_uncertain
    show_screen "$PANE"
    die 5 "cannot confirm the agent received the stage line; check pane $PANE before sending it again"
  fi
  ((prc == 0)) || die 1 "sending the stage line failed: $(herdr_code) ${ERR:0:200}"
  state_write "$path" status=submitted
  printf '%s  %s  pane %s  agent %s (%s, %s)\n' "$id" "${stage:-custom}" "$PANE" "$name" "$PRESET" "$harness"
}

# ---------------------------------------------------------------- tkt resume

cmd_resume() {
  local id='' sid='' as='' focus=0
  while (($#)); do
    case $1 in
      --session)
        (($# >= 2)) || die 2 "--session needs a session id"
        sid=$2
        shift 2
        ;;
      --as)
        (($# >= 2)) || die 2 "--as needs a preset name"
        as=$2
        shift 2
        ;;
      --focus) focus=1 && shift ;;
      --dry-run) DRY=1 && shift ;;
      -h | --help) usage && return 0 ;;
      -*) die 2 "resume: unknown option $1" ;;
      *)
        [[ -z $id ]] || die 2 "resume takes one ticket id"
        id=$1
        shift
        ;;
    esac
  done
  [[ $id ]] || die 2 "usage: tkt resume ID"
  need_tools git jq wt flock timeout
  repo_resolve
  cfg_load
  presets_load
  id=$(normalize_id "$id")
  TICKET=$id
  need_herdr
  local path running
  path=$(ticket_path "$id")
  state_read "$path"
  running=$(agents_in_path "$path" "$(agents_json)")
  if [[ $(jq length <<<"$running") != 0 ]]; then
    local where
    where=$(jq -r '.[0] | "\(.pane_id) (\(.agent), \(.agent_status))"' <<<"$running")
    info "$id already has an agent in pane $where"
    if ((focus && !DRY)); then herdr_json tab focus "$(jq -r '.[0].tab_id' <<<"$running")" >/dev/null; fi
    return 0
  fi

  if [[ $as ]]; then
    preset_known "$as"
    PRESET=$as
  elif [[ ${ST[preset]-} && ${P_HARNESS[${ST[preset]}]+x} ]]; then
    PRESET=${ST[preset]}
  else
    PRESET=
  fi
  local harness='' want=''
  if [[ $as ]]; then want=${P_HARNESS[$as]}; fi
  if [[ $sid ]]; then
    if [[ $sid == ses* ]]; then harness=opencode; else harness=claude; fi
  elif [[ ${ST[session]-} && ${ST[harness]-} ]] && [[ -z $want || ${ST[harness]} == "$want" ]]; then
    sid=${ST[session]}
    harness=${ST[harness]}
  else
    local c o
    c=$(claude_newest_session "$path")
    o=$(oc_newest_session "$path")
    if [[ $want == claude ]]; then o=; fi
    if [[ $want == opencode ]]; then c=; fi
    if [[ $c && (-z $o || ${c%% *} -ge ${o%% *}) ]]; then
      harness=claude
      sid=${c#* }
    elif [[ $o ]]; then
      harness=opencode
      sid=${o#* }
    fi
  fi
  [[ $sid ]] || die 4 "found no session for $id; start one with tkt run $id STAGE"
  if [[ -z $PRESET || ${P_HARNESS[$PRESET]} != "$harness" ]]; then
    local p
    PRESET=
    for p in "${P_ORDER[@]}"; do
      if [[ ${P_HARNESS[$p]} == "$harness" ]]; then
        PRESET=$p
        break
      fi
    done
    [[ $PRESET ]] || die 3 "no preset uses $harness; add one to $CFG_DIR/presets"
  fi
  need_tools "$harness"
  if [[ $harness == claude ]]; then
    local holder
    holder=$(agents_json | jq -r --arg s "$sid" '[.[] | select(.agent_session.value == $s)][0].pane_id // empty')
    [[ -z $holder ]] || die 4 "session $sid already runs in pane $holder"
  fi
  lock_ticket "$id"
  pick_pane "$id" "$path" ""
  if ((!DRY)); then pane_free "$PANE" || die 4 "pane $PANE is busy"; fi
  local name
  name=$(agent_name_for "$id")
  local -a largs
  mapfile -t largs < <(launch_args "$harness" resume "$sid" "$PRESET" "$path")
  local rc=0
  launch_agent "$PANE" "$name" "$harness" "${largs[@]}" || rc=$?
  if ((rc == 2)); then
    show_screen "$PANE"
    die 5 "the agent stopped at a startup dialog in pane $PANE; answer it there"
  fi
  ((rc == 0)) || die 1 "$LAUNCH_ERR"
  state_write "$path" ticket="$id" preset="$PRESET" harness="$harness" tab="$TAB" pane="$PANE" agent="$name" session="$sid" status=resumed
  if ((focus && !DRY)); then herdr_json tab focus "$TAB" >/dev/null; fi
  printf '%s  resumed %s session %s in pane %s\n' "$id" "$harness" "$sid" "$PANE"
}

# ---------------------------------------------------------------- tkt done

# Sets REASONS (why the ticket cannot be removed) and CLOSE_TABS.
done_check() {
  local id=$1 path=$2 agents=$3 panes=$4 tabs=$5 prs open merged tip oid mine pid
  REASONS=()
  CLOSE_TABS=()
  run timeout 60 gh pr list --repo "$GH_REPO" --head "$id" --state all --limit 100 \
    --json number,state,headRefName,headRefOid,headRepository
  if ((RC != 0)); then
    REASONS+=("gh pr list failed: ${ERR:0:200}")
  else
    prs=$(jq -c --arg b "$id" --arg r "$FORGE_REPO" \
      '[.[] | select(.headRefName == $b and ((.headRepository.nameWithOwner // $r) | ascii_downcase) == ($r | ascii_downcase))]' <<<"$OUT")
    open=$(jq '[.[] | select(.state == "OPEN")] | length' <<<"$prs")
    merged=$(jq '[.[] | select(.state == "MERGED")] | length' <<<"$prs")
    if ((open > 0)); then REASONS+=("pull request #$(jq -r '[.[] | select(.state == "OPEN")][0].number' <<<"$prs") is still open"); fi
    if ((merged == 0)); then REASONS+=("no merged pull request has $id as its head branch"); fi
    if ((merged > 1)); then REASONS+=("several merged pull requests have $id as their head branch"); fi
    oid=$(jq -r '[.[] | select(.state == "MERGED")][0].headRefOid // empty' <<<"$prs")
  fi
  worktree_clean "$path" || REASONS+=("the worktree has uncommitted changes")
  tip=$(git -C "$path" rev-parse HEAD)
  if [[ $tip != "${oid:-none}" ]] && ! git -C "$ROOT" merge-base --is-ancestor "$tip" "refs/remotes/$REMOTE/$BASE" 2>/dev/null; then
    REASONS+=("the branch tip ${tip:0:7} is neither the merged head nor in $REMOTE/$BASE")
  fi
  if [[ $(jq '[.[] | select(.agent_status == "working" or .agent_status == "blocked")] | length' <<<"$agents") != 0 ]]; then
    REASONS+=("an agent in the worktree is working or waiting for an answer")
  fi
  if is_inside "$PWD" "$path"; then REASONS+=("tkt runs inside the worktree; run it from another directory"); fi
  mine=$(ticket_tabs "$id" "$tabs")
  local t tab_ids=()
  mapfile -t tab_ids < <(jq -r '.[].tab_id' <<<"$mine")
  for t in "${tab_ids[@]}"; do
    if [[ $t == "${HERDR_TAB_ID:-}" ]]; then REASONS+=("tkt runs in the ticket's own tab"); fi
    if jq -e --arg t "$t" --arg p "$path" 'all(.[] | select(.tab_id == $t); (.cwd // "") as $c | $c == $p or ($c | startswith($p + "/")))' <<<"$panes" >/dev/null; then
      CLOSE_TABS+=("$t")
    fi
  done
  local foreign
  foreign=$(jq -r --arg p "$path" --argjson keep "$(printf '%s\n' "${CLOSE_TABS[@]}" | jq -R . | jq -s 'map(select(. != ""))')" \
    '[.[] | select((.cwd // "") as $c | ($c == $p or ($c | startswith($p + "/"))) and ((.tab_id) as $t | $keep | index($t) | not))] | map(.pane_id) | join(", ")' <<<"$panes")
  if [[ $foreign ]]; then REASONS+=("panes outside the ticket's tabs work in the worktree: $foreign"); fi
  for pid in $(pgrep -f 'opencode serve' 2>/dev/null || true); do
    if is_inside "$(readlink "/proc/$pid/cwd" 2>/dev/null || true)" "$path"; then
      REASONS+=("the OpenCode service runs from inside the worktree, and removing it would stop that service")
    fi
  done
}

cmd_done() {
  local all=0 yes=0
  local -a ids=()
  while (($#)); do
    case $1 in
      --all) all=1 && shift ;;
      --yes) yes=1 && shift ;;
      --dry-run) DRY=1 && shift ;;
      -h | --help) usage && return 0 ;;
      -*) die 2 "done: unknown option $1" ;;
      *) ids+=("$1") && shift ;;
    esac
  done
  ((all || ${#ids[@]})) || die 2 "usage: tkt done ID... or tkt done --all"
  ((!all || !${#ids[@]})) || die 2 "give ticket ids or --all, not both"
  need_tools git jq wt flock timeout
  repo_resolve
  cfg_load
  need_github 'done'
  need_herdr

  if ((DRY)); then
    warn "dry run: not fetching, so merged state is as of the last fetch"
  else
    run git -C "$ROOT" fetch --prune --quiet "$REMOTE"
    if ((RC != 0)); then
      sleep 1
      run git -C "$ROOT" fetch --prune --quiet "$REMOTE"
    fi
    ((RC == 0)) || warn "git fetch failed: ${ERR:0:200}"
  fi

  local id path
  local -A paths=()
  if ((all)); then
    while IFS=$'\t' read -r id path; do
      ids+=("$id")
      paths[$id]=$path
    done < <(ticket_worktrees)
    ((${#ids[@]})) || {
      info "no ticket worktrees"
      return 0
    }
    if ((!yes)); then
      [[ -t 0 ]] || die 2 "tkt done --all needs --yes when stdin is not a terminal"
      printf 'tkt: check and remove these ticket worktrees: %s\n' "${ids[*]}" >&2
      local answer
      read -r -p 'tkt: continue? [y/N] ' answer
      [[ $answer == [yY]* ]] || die 2 "stopped"
    fi
  else
    local i
    for i in "${!ids[@]}"; do ids[i]=$(normalize_id "${ids[i]}"); done
  fi

  local agents panes tabs failed=0 t
  agents=$(agents_json)
  panes=$(panes_json)
  tabs=$(tabs_json)
  for id in "${ids[@]}"; do
    TICKET=$id
    path=${paths[$id]-}
    if [[ -z $path ]]; then
      path=$(wt_path_for "$id")
      if [[ -z $path ]]; then
        warn "$id: no worktree"
        failed=1
        continue
      fi
    fi
    lock_ticket "$id"
    done_check "$id" "$path" "$(agents_in_path "$path" "$agents")" "$panes" "$tabs"
    if ((${#REASONS[@]})); then
      printf 'tkt: %s kept:\n' "$id" >&2
      printf '  - %s\n' "${REASONS[@]}" >&2
      failed=1
      continue
    fi
    for t in "${CLOSE_TABS[@]}"; do
      if ((DRY)); then would herdr tab close "$t"; else herdr_json tab close "$t" >/dev/null; fi
    done
    if ((DRY)); then
      would wt -C "$ROOT" remove "$id" --foreground --reap --format json
      continue
    fi
    run_visible wt -C "$ROOT" remove "$id" --foreground --reap --format json
    ((RC == 0)) || die 1 "wt remove $id failed (see above)"
    if git -C "$ROOT" show-ref --verify --quiet "refs/heads/$id"; then
      printf '%s  removed %s; worktrunk kept branch %s (not integrated into %s)\n' "$id" "$path" "$id" "$BASE"
    else
      printf '%s  removed %s and branch %s\n' "$id" "$path" "$id"
    fi
  done
  if ((failed && !all)); then exit 4; fi
  return 0
}

# ---------------------------------------------------------------- tkt ls

# shellcheck disable=SC2016 # jq program, not shell
readonly JQ_REVIEW='
def verdict($head):
  [ .reviews[]? as $r | ($r.body // "") as $b
    | if ($b | test("Automated review: (CLEAR|FINDINGS|STALE_BASE)")) then
        { v: ($b | capture("Automated review: (?<v>CLEAR|FINDINGS|STALE_BASE)").v),
          h: (((first($b | capture("head `(?<h>[0-9a-f]{7,40})`")) // {}) | .h) // $r.commit.oid),
          at: $r.submittedAt }
      elif ($b | test("(?m)^Verdict: (CHANGES_REQUESTED|READY_FOR_HUMAN)")) then
        { v: ($b | capture("(?m)^Verdict: (?<v>CHANGES_REQUESTED|READY_FOR_HUMAN)").v),
          h: (((first($b | capture("(?m)^Reviewed head: `?(?<h>[0-9a-f]{7,40})")) // {}) | .h) // $r.commit.oid),
          at: $r.submittedAt }
      else empty end ]
  | sort_by(.at) | last
  | if . == null then null else . + { at_head: (.h as $h | $head | startswith($h)) } end;

def checks:
  [ .statusCheckRollup[]?
    | if has("context") then
        { name: .context,
          s: (if .state == "PENDING" or .state == "EXPECTED" then "pending"
              elif .state == "FAILURE" or .state == "ERROR" then "fail" else "ok" end) }
      else
        { name: .name,
          s: (if .status != "COMPLETED" then "pending"
              elif (.conclusion | IN("FAILURE", "TIMED_OUT", "CANCELLED", "ACTION_REQUIRED", "STARTUP_FAILURE")) then "fail"
              else "ok" end) }
      end ]
  | if length == 0 then { state: "none", text: "-" }
    elif any(.s == "fail") then { state: "fail", text: ("fail: " + ([.[] | select(.s == "fail") | .name] | unique | join(","))) }
    elif any(.s == "pending") then { state: "pending", text: ("pending " + ([.[] | select(.s == "pending")] | length | tostring)) }
    else { state: "ok", text: ("ok " + (length | tostring)) } end;
'

# Picks the next step for one row; the fields come from cmd_ls.
next_step() {
  local id=$1 pr_state=$2 agent=$3 last=$4 checks=$5 verdict=$6 at_head=$7 mergeable=$8
  if [[ $pr_state == MERGED ]]; then printf 'tkt done %s' "$id"; return; fi
  if [[ $pr_state == CLOSED ]]; then printf 'closed without merging'; return; fi
  if [[ $agent == working ]]; then printf 'wait (agent working)'; return; fi
  if [[ $agent == blocked ]]; then printf 'answer the agent in its tab'; return; fi
  if [[ -z $pr_state ]]; then
    if [[ -z $agent || $agent == - ]]; then printf 'tkt resume %s' "$id"
    elif [[ $last == AWAITING_APPROVAL ]]; then printf 'approve the plan in its tab'
    elif [[ $last == BLOCKED ]]; then printf "read the agent's reason in its tab"
    else printf 'check the agent in its tab'; fi
    return
  fi
  if [[ $checks == pending ]]; then printf 'wait for CI'; return; fi
  if [[ $at_head == true && $verdict == STALE_BASE ]] || [[ $mergeable == CONFLICTING ]]; then printf 'tkt run %s sync' "$id"; return; fi
  if [[ $at_head == true && ($verdict == FINDINGS || $verdict == CHANGES_REQUESTED) ]]; then printf 'tkt run %s address' "$id"; return; fi
  if [[ $checks == fail ]]; then printf 'tkt run %s ci' "$id"; return; fi
  if [[ $at_head == true && ($verdict == CLEAR || $verdict == READY_FOR_HUMAN) ]]; then printf 'tkt run %s verify' "$id"; return; fi
  printf 'wait for review'
}

cmd_ls() {
  local fetch=1
  while (($#)); do
    case $1 in
      --no-fetch) fetch=0 && shift ;;
      -h | --help) usage && return 0 ;;
      *) die 2 "ls: unknown argument $1" ;;
    esac
  done
  need_tools git jq wt timeout column
  repo_resolve
  cfg_load
  local failed=0 have_herdr=0 have_gh=0 agents='[]' tabs='[]' open_prs='[]' all_prs='[]'
  if ((fetch)); then
    run git -C "$ROOT" fetch --prune --quiet "$REMOTE"
    ((RC == 0)) || warn "git fetch failed; showing the last fetched state"
  fi
  if [[ ${HERDR_ENV:-} == 1 ]] && command -v herdr >/dev/null 2>&1; then
    have_herdr=1
    agents=$(agents_json)
    tabs=$(tabs_json)
  fi
  if [[ $FORGE_KIND == GitHub ]] && command -v gh >/dev/null 2>&1 && [[ $FORGE_HOST && $FORGE_REPO ]]; then
    GH_REPO=$FORGE_HOST/$FORGE_REPO
    have_gh=1
    run timeout 60 gh pr list --repo "$GH_REPO" --state open --limit 100 \
      --json number,headRefName,headRefOid,headRepository,mergeable,statusCheckRollup,reviews
    if ((RC == 0)); then open_prs=$OUT; else failed=1 && have_gh=0 && warn "gh pr list failed: ${ERR:0:200}"; fi
    if ((have_gh)); then
      run timeout 60 gh pr list --repo "$GH_REPO" --state all --limit 200 --json number,state,headRefName,headRepository
      if ((RC == 0)); then all_prs=$OUT; else failed=1 && warn "gh pr list failed: ${ERR:0:200}"; fi
    fi
  fi

  local id path rows header
  header=$'TICKET\tTAB\tAGENT\tLAST STATUS\tPR\tCHECKS\tREVIEW\tBEHIND\tNEXT'
  rows=
  while IFS=$'\t' read -r id path; do
    TICKET=$id
    local tab=- agent=- last=- pr=- checks_txt=- checks_state='' review=- verdict='' at_head='' behind=- mergeable='' pr_state=''
    if ((have_herdr)); then
      local a
      tab=$(ticket_tabs "$id" "$tabs" | jq -r 'map(.label) | join(", ") | if . == "" then "-" else . end')
      a=$(agents_in_path "$path" "$agents" | jq -c '.[0] // empty')
      if [[ $a ]]; then
        agent=$(jq -r .agent_status <<<"$a")
        if [[ $agent == idle || $agent == 'done' ]]; then
          last=$(herdr agent read "$(jq -r .pane_id <<<"$a")" --source visible --lines 40 2>/dev/null |
            grep -oE 'Status: [A-Z_]+' | tail -n 1 | sed 's/^Status: //' || true)
          last=${last:--}
        fi
      fi
    else
      tab='?'
      agent='?'
    fi
    if ((have_gh)); then
      local p
      p=$(jq -c --arg b "$id" --arg r "$FORGE_REPO" \
        '[.[] | select(.headRefName == $b and ((.headRepository.nameWithOwner // $r) | ascii_downcase) == ($r | ascii_downcase))][0] // empty' <<<"$open_prs")
      if [[ $p ]]; then
        pr_state=OPEN
        pr="#$(jq -r .number <<<"$p")"
        mergeable=$(jq -r '.mergeable // empty' <<<"$p")
        checks_state=$(jq -r "$JQ_REVIEW checks | .state" <<<"$p")
        checks_txt=$(jq -r "$JQ_REVIEW checks | .text" <<<"$p")
        local v
        v=$(jq -c --arg h "$(jq -r .headRefOid <<<"$p")" "$JQ_REVIEW verdict(\$h)" <<<"$p")
        if [[ $v != null ]]; then
          verdict=$(jq -r .v <<<"$v")
          at_head=$(jq -r .at_head <<<"$v")
          if [[ $at_head == true ]]; then review=$verdict; else review="$verdict (old head)"; fi
        fi
      else
        p=$(jq -c --arg b "$id" '[.[] | select(.headRefName == $b)] | (map(select(.state == "MERGED"))[0] // .[0]) // empty' <<<"$all_prs")
        if [[ $p ]]; then
          pr_state=$(jq -r .state <<<"$p")
          pr="#$(jq -r .number <<<"$p") $(tr '[:upper:]' '[:lower:]' <<<"$pr_state")"
        fi
      fi
    else
      pr='?'
    fi
    if git -C "$ROOT" rev-parse --verify --quiet "refs/remotes/$REMOTE/$BASE" >/dev/null; then
      behind=$(git -C "$path" rev-list --count "HEAD..refs/remotes/$REMOTE/$BASE")
    fi
    local next
    if ((have_gh)); then
      next=$(next_step "$id" "$pr_state" "$agent" "$last" "$checks_state" "$verdict" "$at_head" "$mergeable")
    else
      next='?'
    fi
    rows+="$id"$'\t'"$tab"$'\t'"$agent"$'\t'"$last"$'\t'"$pr"$'\t'"$checks_txt"$'\t'"$review"$'\t'"$behind"$'\t'"$next"$'\n'
  done < <(ticket_worktrees)
  if [[ -z $rows ]]; then
    info "no ticket worktrees"
  else
    printf '%s\n%s' "$header" "$rows" | column -t -s $'\t'
  fi
  if ((have_herdr == 0 && failed == 0)) && [[ ${HERDR_ENV:-} != 1 ]]; then info "outside herdr: tab and agent columns show ?"; fi
  if ((failed)); then exit 1; fi
  return 0
}

# ---------------------------------------------------------------- main

main() {
  while (($#)); do
    case $1 in
      -C)
        (($# >= 2)) || die 2 "-C needs a directory"
        TKT_DIR=$2
        shift 2
        ;;
      -v) VERBOSE=1 && shift ;;
      --version)
        printf 'tkt %s\n' "$TKT_VERSION"
        return 0
        ;;
      -h | --help | help)
        usage
        return 0
        ;;
      -*) die 2 "unknown option $1" ;;
      *) break ;;
    esac
  done
  (($#)) || {
    usage >&2
    exit 2
  }
  local cmd=$1
  shift
  case $cmd in
    start | run | resume | done | ls) "cmd_$cmd" "$@" ;;
    *) die 2 "unknown command '$cmd' (commands: start, run, resume, done, ls)" ;;
  esac
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then main "$@"; fi
